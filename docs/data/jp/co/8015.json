2581851.0,"op":123292.0,"ni":96304.0,"opm":4.8,"yoy":{"rev":0.5,"op":1.9,"ni":null},"qoq":{"rev":2.5,"op":-4.4,"ni":null}},{"label":"25.01-03","cq":"1Q25","rev":2661779.0,"op":125964.0,"ni":84655.0,"opm":4.7,"yoy":{"rev":7.3,"op":44.0,"ni":null},"qoq":{"rev":3.1,"op":2.2,"ni":-12.1}},{"label":"25.04-06","cq":"2Q25","rev":2593820.0,"op":126595.0,"ni":98344.0,"opm":4.9,"yoy":{"rev":2.1,"op":6.3,"ni":null},"qoq":{"rev":-2.6,"op":0.5,"ni":16.2}},{"label":"25.07-09","cq":"3Q25","rev":2820564.0,"op":134535.0,"ni":88576.0,"opm":4.8,"yoy":{"rev":11.9,"op":4.4,"ni":null},"qoq":{"rev":8.7,"op":6.3,"ni":-9.9}},{"label":"25.10-12","cq":"4Q25","rev":2967216.0,"op":142071.0,"ni":100050.0,"opm":4.8,"yoy":{"rev":14.9,"op":15.2,"ni":3.9},"qoq":{"rev":5.2,"op":5.6,"ni":13.0}},{"label":"26.01-03","cq":"1Q26","rev":3180335.0,"op":142034.0,"ni":83546.0,"opm":4.5,"yoy":{"rev":19.5,"op":12.8,"ni":-1.3},"qoq":{"rev":7.2,"op":-0.0,"ni":-16.5}},{"label":"26.04-06","cq":"2Q26","rev":3570117.0,"op":184379.0,"ni":135260.0,"opm":5.2,"yoy":{"rev":37.6,"op":45.6,"ni":37.5},"qoq":{"rev":12.3,"op":29.8,"ni":61.9}},{"label":"26.07-09","cq":"3Q26","rev":3610499.0,"op":186915.0,"ni":126766.0,"opm":5.2,"yoy":{"rev":28.0,"op":38.9,"ni":43.1},"qoq":{"rev":1.1,"op":1.4,"ni":-6.3}}],"note":{"headline":"양호 — 7~9월(3Q26) 순이익 1,268억엔으로 43% 증가, 메모리·자원 값과 엔화 약세가 끌었지만 연간 순이익 계획은 그대로 둬 남은 두 분기는 감익 계산","about":"도요타 그룹의 종합상사. 도요타 공장에 쓰이는 강판·부품을 대고, 완성차를 해외에 수출·판매하며, 철·비철 스크랩 재활용과 메모리 반도체·전자부품 유통, 풍력 발전까지 한다.\n프랑스 자회사 CFAO를 통해 아프리카에서 자동차·의약품 유통을 크게 하는 것이 다른 상사와 다른 점이다.","summary_md":"- **판정 양호.** 7~9월 순이익은 1,268억엔으로 1년 전보다 43.1% 늘었다. 4~9월 두 분기에 연간 계획의 60.9%를 벌어 같은 시점 5년 평균(53.0%)보다 7.9%포인트 앞섰다. 다만 영업활동 현금흐름이 적자로 돌아서 한 단계 낮춰 매겼다.\n- 매출(수익)은 3조6,105억엔으로 28.0%, 영업이익은 1,869억엔으로 38.9% 늘었다. 영업이익률은 5.2%로 1년 전 4.8%보다 0.4%포인트 올랐다.\n- 이익을 끈 건 시세다. 디지털 솔루션(메모리 유통) 순이익이 2.3배, 순환경제(스크랩·자원) 순이익이 4.6배가 됐다. 아프리카 자동차 판매도 늘어 아프리카 부문이 54% 늘었다.\n- 7~9월에는 남미 재생에너지 손상 65억엔 등 일회성 손실이 약 50억엔 있었다. 이를 빼면 순이익은 약 1,318억엔으로 4~6월과 같은 수준이다.\n- 연간 순이익 계획 4,300억엔은 유지했다. 회사는 남은 두 분기의 불확실성을 이유로 들었다. 계획대로면 10~3월 두 분기 순이익은 1,680억엔으로 1년 전보다 8.5% 적다.\n- 발표 날 주가는 2.1% 내린 7,247엔. 6월 자사주 6,636억엔 매입으로 순차입금이 두 배가 됐고, 영업활동 현금흐름은 29억엔 적자였다."}}