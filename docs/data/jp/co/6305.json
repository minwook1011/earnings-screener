e_d":"2026-10-29","base":5105.0,"timing":"after","time_known":true,"d1":null,"d1_d":null,"d5":null,"d5_d":null}},"qs":[{"label":"24.10-12","cq":"4Q24","rev":325540.0,"op":33174.0,"ni":30131.0,"opm":10.2,"yoy":{"rev":-5.0,"op":-14.9,"ni":null},"qoq":{"rev":-3.5,"op":-12.7,"ni":null}},{"label":"25.01-03","cq":"1Q25","rev":380008.0,"op":40501.0,"ni":19550.0,"opm":10.7,"yoy":{"rev":-4.4,"op":-0.7,"ni":null},"qoq":{"rev":16.7,"op":22.1,"ni":-35.1}},{"label":"25.04-06","cq":"2Q25","rev":306152.0,"op":22123.0,"ni":11280.0,"opm":7.2,"yoy":{"rev":-6.7,"op":-32.6,"ni":null},"qoq":{"rev":-19.4,"op":-45.4,"ni":-42.3}},{"label":"25.07-09","cq":"3Q25","rev":347899.0,"op":38025.0,"ni":26470.0,"opm":10.9,"yoy":{"rev":3.1,"op":0.1,"ni":null},"qoq":{"rev":13.6,"op":71.9,"ni":134.7}},{"label":"25.10-12","cq":"4Q25","rev":325298.0,"op":32444.0,"ni":18456.0,"opm":10.0,"yoy":{"rev":-0.1,"op":-2.2,"ni":-38.7},"qoq":{"rev":-6.5,"op":-14.7,"ni":-30.3}},{"label":"26.01-03","cq":"1Q26","rev":426144.0,"op":40359.0,"ni":16987.0,"opm":9.5,"yoy":{"rev":12.1,"op":-0.4,"ni":-13.1},"qoq":{"rev":31.0,"op":24.4,"ni":-8.0}},{"label":"26.04-06","cq":"2Q26","rev":329130.0,"op":34439.0,"ni":28037.0,"opm":10.5,"yoy":{"rev":7.5,"op":55.7,"ni":148.6},"qoq":{"rev":-22.8,"op":-14.7,"ni":65.0}},{"label":"26.07-09","cq":"3Q26","rev":368946.0,"op":40747.0,"ni":21647.0,"opm":11.0,"yoy":{"rev":6.0,"op":7.2,"ni":-18.2},"qoq":{"rev":12.1,"op":18.3,"ni":-22.8}}],"note":{"headline":"부진 — 7~9월(3Q26) 매출 3,689억엔(+6.0%)·조정 영업이익 407억엔(+7.2%)으로 본업은 늘었지만, 금융비용이 늘어 주당순이익은 시장 예상보다 15% 적었다. 연간 계획은 올렸다","about":"일본 2위, 세계 상위권 건설기계 회사. 유압 굴착기·휠로더와 광산용 초대형 굴착기·덤프트럭을 만들고, 부품·정비 매출 비중이 높다.\n매출의 86%가 해외이고 북미·오세아니아(호주 광산)·유럽이 크다. 2026년 8월 옛 모회사 히타치제작소가 남은 지분을 모두 팔았고, 2027년 4월 회사 이름을 '랜드크로스'로 바꾼다.","summary_md":"- **판정 부진.** 7~9월 주당순이익 103.29엔은 애널리스트 2명 평균 121.25엔보다 14.8% 적었다. 기준대로면 쇼크지만 연간 계획을 올려 한 단계 올렸다. 본업 이익은 늘었고 줄어든 것은 영업 밖 비용이다.\n- 매출은 3,689억엔으로 6.0% 늘어 애널리스트 7명 평균 3,679억엔과 거의 같았다. 오세아니아(+26%), 인도(+32%), 북미(+9%)가 늘고 중동(−56%), 아프리카(−23%)가 줄었다.\n- 조정 영업이익은 407억엔으로 7.2% 늘었고 이익률은 11.0%로 1년 전보다 0.1%포인트 높다. 매출총이익률이 1.3%포인트 올랐지만 판관비가 12.5% 늘었다.\n- 순이익은 216억엔으로 18.2% 줄었다. 금융비용이 66억엔에서 111억엔으로 늘었고, 1년 전 있던 기타 수익 97억엔이 41억엔으로 줄었다. 회사는 금융비용 증가 이유를 단신에 밝히지 않았다.\n- 연간 계획을 매출 1조5,000억엔(+2.0%), 조정 영업이익 1,550억엔(+3.3%), 순이익 900억엔(+7.1%)으로 올렸다. 배당 190엔(전기 175엔) 계획은 그대로다.\n- 발표는 장 마감 뒤였다. 종가는 코마쓰 급락 영향으로 5,105엔(−2.4%), 야간 거래는 5,150엔(+0.9%)이었다."}}