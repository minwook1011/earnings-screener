10-29","base":495.1,"timing":"after","time_known":true,"d1":null,"d1_d":null,"d5":null,"d5_d":null}},"qs":[{"label":"24.10-12","cq":"4Q24","rev":1608362.0,"op":112053.0,"ni":53597.0,"opm":7.0,"yoy":{"rev":1.2,"op":303.1,"ni":9807.0},"qoq":{"rev":-13.5,"op":-17.7,"ni":-51.4}},{"label":"25.01-03","cq":"1Q25","rev":1847072.0,"op":-76613.0,"ni":-81881.0,"opm":-4.1,"yoy":{"rev":2.0,"op":null,"ni":null},"qoq":{"rev":14.8,"op":-168.4,"ni":-252.8}},{"label":"25.04-06","cq":"2Q25","rev":1425123.0,"op":64699.0,"ni":-857690.0,"opm":4.5,"yoy":{"rev":-4.4,"op":2.9,"ni":-1182.9},"qoq":{"rev":-22.8,"op":null,"ni":null}},{"label":"25.07-09","cq":"3Q25","rev":1725151.0,"op":152355.0,"ni":145293.0,"opm":8.8,"yoy":{"rev":-7.2,"op":11.9,"ni":31.7},"qoq":{"rev":21.1,"op":135.5,"ni":null}},{"label":"25.10-12","cq":"4Q25","rev":1461902.0,"op":41352.0,"ni":49745.0,"opm":2.8,"yoy":{"rev":-9.1,"op":-63.1,"ni":-7.2},"qoq":{"rev":-15.3,"op":-72.9,"ni":-65.8}},{"label":"26.01-03","cq":"1Q26","rev":1716398.0,"op":79283.0,"ni":208389.0,"opm":4.6,"yoy":{"rev":-7.1,"op":null,"ni":null},"qoq":{"rev":17.4,"op":91.7,"ni":318.9}},{"label":"26.04-06","cq":"2Q26","rev":1481197.0,"op":-34270.0,"ni":-9793.0,"opm":-2.3,"yoy":{"rev":3.9,"op":-153.0,"ni":null},"qoq":{"rev":-13.7,"op":-143.2,"ni":-104.7}},{"label":"26.07-09","cq":"3Q26","rev":1790113.0,"op":606.0,"ni":62517.0,"opm":0.0,"yoy":{"rev":3.8,"op":-99.6,"ni":-57.0},"qoq":{"rev":20.9,"op":null,"ni":null}}],"note":{"headline":"쇼크 — 7~9월(3Q26) 영업이익 6억엔(1년 전 1,524억엔), 경상이익 792억엔(−56%). 연료·도매 전력값 급등으로 소매 에너지파트너 199억엔 적자, 송배전 이익 91% 감소. 제라 지분 이익만 762억엔으로 2배. 연간 예상은 계속 미정","about":"수도권 전력 회사. 지주회사 아래 소매(에너지파트너), 송배전망(파워그리드), 수력·재생에너지(리뉴어블파워), 중부전력과 반반 출자한 발전·연료 회사 제라(퓨얼&파워, 지분법)로 나뉜다.\n후쿠시마 제1원전 사고 배상·폐로를 떠안고 있고, 가시와자키가리와 원전 6호기가 영업 운전 중이다. 연료값이 요금에 늦게 붙는 '기간 차이' 손익이 분기 이익을 흔든다.","summary_md":"- **판정 쇼크.** 회사 연간 계획이 없어 전년 대비로 봤다. 7~9월 영업이익은 6억엔으로 1년 전 1,524억엔에서 99.6% 줄었고, 영업이익률은 8.8%에서 0.0%가 됐다.\n- 7~9월 매출 1조7,901억엔(+3.8%), 경상이익 792억엔(1년 전 1,809억엔), 순이익 625억엔(1년 전 1,453억엔). 매출은 애널리스트 1명 예상 1조7,672억엔보다 1.3% 많았다.\n- 소매 에너지파트너는 7~9월 경상손실 199억엔으로 1년 전 772억엔 이익에서 돌아섰다. 소매 판매량이 17.7% 줄고 조달 단가가 올랐다.\n- 송배전 파워그리드는 67억엔으로 1년 전 715억엔에서 91% 줄었다. 수급 조정 비용이 늘었다. 반면 제라 몫인 퓨얼&파워는 762억엔으로 1년 전의 2.3배다.\n- 연료값이 요금에 늦게 붙는 기간 차이는 7~9월 약 250억엔 손실(1년 전 약 100억엔 이익)이다. 이를 빼도 경상이익은 39% 줄었다.\n- 연간 예상과 배당은 계속 미정. 장 마감 뒤 발표라 주가 반응은 10월 30일 확인한다."}}