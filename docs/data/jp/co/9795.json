":1152.0,"opm":36.9,"yoy":{"rev":9.5,"op":14.8,"ni":12.9},"qoq":{"rev":15.1,"op":113.2,"ni":90.7}},{"label":"25.01-03","cq":"1Q25","rev":3646.0,"op":687.0,"ni":500.0,"opm":18.8,"yoy":{"rev":1.8,"op":-11.8,"ni":-9.3},"qoq":{"rev":-19.2,"op":-58.7,"ni":-56.6}},{"label":"25.04-06","cq":"2Q25","rev":3639.0,"op":496.0,"ni":337.0,"opm":13.6,"yoy":{"rev":4.6,"op":-0.2,"ni":-0.6},"qoq":{"rev":-0.2,"op":-27.8,"ni":-32.6}},{"label":"25.07-09","cq":"3Q25","rev":4048.0,"op":932.0,"ni":700.0,"opm":23.0,"yoy":{"rev":3.3,"op":19.3,"ni":15.9},"qoq":{"rev":11.2,"op":87.9,"ni":107.7}},{"label":"25.10-12","cq":"4Q25","rev":4549.0,"op":1634.0,"ni":1168.0,"opm":35.9,"yoy":{"rev":0.8,"op":-1.9,"ni":1.4},"qoq":{"rev":12.4,"op":75.3,"ni":66.9}},{"label":"26.01-03","cq":"1Q26","rev":3807.0,"op":746.0,"ni":529.0,"opm":19.6,"yoy":{"rev":4.4,"op":8.6,"ni":5.8},"qoq":{"rev":-16.3,"op":-54.3,"ni":-54.7}},{"label":"26.04-06","cq":"2Q26","rev":3864.0,"op":646.0,"ni":455.0,"opm":16.7,"yoy":{"rev":6.2,"op":30.2,"ni":35.0},"qoq":{"rev":1.5,"op":-13.4,"ni":-14.0}},{"label":"26.07-09","cq":"3Q26","rev":4201.0,"op":1023.0,"ni":685.0,"opm":24.4,"yoy":{"rev":3.8,"op":9.8,"ni":-2.1},"qoq":{"rev":8.7,"op":58.4,"ni":50.5}}],"note":{"headline":"회사 계획 대비 양호 — 7~9월(3Q26) 매출 +3.8%·영업이익 +9.8%, 여름 강습으로 학생이 최고 3만 8,120명. 다음 기는 영업이익 +3.1%로 낮게 잡고 누진 배당을 도입했다","about":"가나가와현 후지사와에 본사를 둔 입시 학원. 고교 입시 '스텝'(중학생 중심)과 대학 입시 '스텝'(고교생), 학동 교실 '스텝 키즈'를 가나가와현 안에서만 운영하며 학생은 약 3만 8천 명이다.\n가나가와 공립 명문고 합격자 수 1위가 최대 무기로, 수업료가 매출 전부다. 여름 강습이 있는 7~9월과 겨울 강습·입시 직전의 10~12월에 이익이 몰린다.","summary_md":"- **양호(회사 계획 대비)**: 연간 경상이익 41.7억엔이 회사 계획(40.2억엔)을 3.7% 넘었다. 7~9월만 보면 계획에서 역산한 영업이익(9.2억엔)보다 11.8% 많다.\n- **3Q26(7~9월, 2026년 9월기 4분기) 3개월 실적**: 매출 **42.0억엔(+3.8%)**, 영업이익 **10.2억엔(+9.8%)**, 경상이익 10.8억엔(+11.3%), 순이익 6.85억엔(−2.1%). 영업이익률 **24.4%**(전년 23.0%).\n- **학생이 늘었다**: 9월 말 학생 3만 8,120명으로 최고, 1년 전보다 3.7% 많다. 여름 강습 뒤 6월 말보다 1,855명 늘었다. 초등 1~4학년 +14.2%, 5~6학년 +10.4%로 어린 학년이 성장을 끈다.\n- **순이익만 줄었다**: 7~9월에 감손 손실 1.0억엔을 특별손실로 잡았다. 회사는 대상과 이유를 결산단신에 적지 않았다.\n- **다음 기 계획**: 매출 171.2억엔(+4.2%), 영업이익 41.7억엔(+3.1%), 주당순이익 188.26엔. 배당은 94엔(+3엔)이다. 사립고 수업료 무상화로 조기 퇴원생이 약 350명 늘어 0.56억엔 매출이 빠졌다고 회사가 밝혔다.\n- **주가**: 장 마감 뒤 발표, 반응은 10/30. 발표일 종가 2,155엔 기준 다음 기 계획 주가수익비율 약 11.4배, 배당수익률 약 4.4%."}}