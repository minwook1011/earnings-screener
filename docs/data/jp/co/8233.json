-10-15","base":2191.5,"timing":"after","time_known":true,"d1":-1.5,"d1_d":"2026-10-16","d5":-3.0,"d5_d":"2026-10-22"}},"qs":[{"label":"24.09-11","cq":"4Q24","rev":118298.0,"op":12763.0,"ni":6997.0,"opm":10.8,"yoy":{"rev":4.7,"op":2.9,"ni":-24.7},"qoq":{"rev":-4.1,"op":11.0,"ni":11.8}},{"label":"24.12-02","cq":"1Q25","rev":136762.0,"op":15980.0,"ni":13450.0,"opm":11.7,"yoy":{"rev":3.7,"op":25.8,"ni":82.5},"qoq":{"rev":15.6,"op":25.2,"ni":92.2}},{"label":"25.03-05","cq":"2Q25","rev":112461.0,"op":12635.0,"ni":6996.0,"opm":11.2,"yoy":{"rev":-6.4,"op":-27.0,"ni":-45.3},"qoq":{"rev":-17.8,"op":-20.9,"ni":-48.0}},{"label":"25.06-08","cq":"3Q25","rev":122901.0,"op":11018.0,"ni":14223.0,"opm":9.0,"yoy":{"rev":-0.3,"op":-4.2,"ni":127.2},"qoq":{"rev":9.3,"op":-12.8,"ni":103.3}},{"label":"25.09-11","cq":"4Q25","rev":118459.0,"op":13614.0,"ni":8503.0,"opm":11.5,"yoy":{"rev":0.1,"op":6.7,"ni":21.5},"qoq":{"rev":-3.6,"op":23.6,"ni":-40.2}},{"label":"25.12-02","cq":"1Q26","rev":138549.0,"op":16249.0,"ni":-37916.0,"opm":11.7,"yoy":{"rev":1.3,"op":1.7,"ni":-381.9},"qoq":{"rev":17.0,"op":19.4,"ni":-545.9}},{"label":"26.03-05","cq":"2Q26","rev":119687.0,"op":15971.0,"ni":11082.0,"opm":13.3,"yoy":{"rev":6.4,"op":26.4,"ni":58.4},"qoq":{"rev":-13.6,"op":-1.7,"ni":null}},{"label":"26.06-08","cq":"3Q26","rev":124444.0,"op":11550.0,"ni":4932.0,"opm":9.3,"yoy":{"rev":1.3,"op":4.8,"ni":-65.3},"qoq":{"rev":4.0,"op":-27.7,"ni":-55.5}}],"note":{"headline":"진척률 앞서고 연간 계획 상향(양호) — 6~8월 영업이익 +4.8%, 면세 +22%가 끌었지만 매출은 시장 예상에 2% 못 미쳤고 순이익은 −65%","about":"일본 대형 백화점 회사. 오사카·니혼바시·신주쿠·요코하마·교토 등 대형점을 중심으로 국내 백화점을 운영하고, 싱가포르·베트남·태국·상하이에도 백화점이 있다.\n백화점 외에 상업시설 개발(도신개발), 신용카드·대출 같은 금융, 내장 공사 사업을 함께 하며, 이익의 절반 이상이 백화점 밖에서 나온다.","summary_md":"- **양호 — 연간 계획을 올렸다.** 3Q26(6~8월, 2027년 2월기 2분기) 영업수익 1,244억엔(+1.3%), 영업이익 115.5억엔(+4.8%), 경상이익 115.8억엔(+10.2%). 회사는 연간 영업이익 계획을 575억→590억엔으로 올렸다.\n- **국내 백화점이 이익을 끌었다.** 6~8월 국내 백화점 영업이익은 50억엔(+13.7%). 기존점 매출이 +7%였고, 그중 면세(외국인 관광객) 매출이 +22%였다. 국내 손님 매출도 +5%로 늘었다.\n- **이익률은 조금 올랐다.** 영업이익률은 9.3%로 전년(9.0%)보다 0.3%p 높다. 비싼 명품 비중이 커져 백화점 상품 이익률은 0.15%p 낮아졌지만, 비용 절감으로 판관비율을 0.5%p 낮췄다.\n- **아쉬운 점도 있다.** 매출은 애널리스트 3명 평균(1,271억엔)보다 2.1% 적었다. 순이익은 49억엔으로 65% 줄었다. 전년 같은 분기의 땅 매각 이익 126억엔이 사라졌고, 이번에 대손충당금 26.5억엔을 특별손실로 잡았다.\n- **진척률은 앞선다.** 경상이익 진척률 46.8%는 과거 2년 평균(44.4%)보다 2.4%p 높다. 남은 두 분기 영업이익은 315억엔으로 전년보다 5.5% 늘면 된다.\n- **주가**: 발표일 종가 2,191.5엔. 발표가 장 마감 뒤라 반응은 다음 날 확인해야 한다."}}