":62275.0,"op":21286.0,"ni":14813.0,"opm":34.2,"yoy":{"rev":8.5,"op":26.7,"ni":21.4},"qoq":{"rev":28.7,"op":45.8,"ni":48.1}},{"label":"25.01-03","cq":"1Q25","rev":52055.0,"op":12995.0,"ni":9403.0,"opm":25.0,"yoy":{"rev":5.4,"op":-9.8,"ni":-21.0},"qoq":{"rev":-16.4,"op":-39.0,"ni":-36.5}},{"label":"25.04-06","cq":"2Q25","rev":54028.0,"op":16920.0,"ni":11376.0,"opm":31.3,"yoy":{"rev":7.2,"op":6.4,"ni":2.5},"qoq":{"rev":3.8,"op":30.2,"ni":21.0}},{"label":"25.07-09","cq":"3Q25","rev":51221.0,"op":14154.0,"ni":9630.0,"opm":27.6,"yoy":{"rev":5.8,"op":-3.1,"ni":-3.7},"qoq":{"rev":-5.2,"op":-16.3,"ni":-15.3}},{"label":"25.10-12","cq":"4Q25","rev":66556.0,"op":23847.0,"ni":15970.0,"opm":35.8,"yoy":{"rev":6.9,"op":12.0,"ni":7.8},"qoq":{"rev":29.9,"op":68.5,"ni":65.8}},{"label":"26.01-03","cq":"1Q26","rev":56568.0,"op":14445.0,"ni":10950.0,"opm":25.5,"yoy":{"rev":8.7,"op":11.2,"ni":16.5},"qoq":{"rev":-15.0,"op":-39.4,"ni":-31.4}},{"label":"26.04-06","cq":"2Q26","rev":56132.0,"op":17883.0,"ni":11895.0,"opm":31.9,"yoy":{"rev":3.9,"op":5.7,"ni":4.6},"qoq":{"rev":-0.8,"op":23.8,"ni":8.6}},{"label":"26.07-09","cq":"3Q26","rev":54510.0,"op":14942.0,"ni":9856.0,"opm":27.4,"yoy":{"rev":6.4,"op":5.6,"ni":2.3},"qoq":{"rev":-2.9,"op":-16.4,"ni":-17.1}}],"note":{"headline":"부진 — 7~9월(3Q26) 매출 545억엔(+6.4%)·영업이익 149억엔(+5.6%)으로 늘었지만, 주당순이익 11.29엔은 시장 예상보다 6% 적었다. 선선한 날씨로 여름옷 판매가 약했다","about":"일본 최대 패션 온라인몰 '조조타운'을 운영한다. 브랜드 상품을 맡아 팔고 수수료를 받는 위탁 판매가 중심이고, 중고 의류와 야후 쇼핑 입점점, 광고 매출도 있다.\n2025년 영국 패션 검색 사이트 '리스트(LYST)'를 사들였고 2026년 4월 화장품 쇼핑몰 회사 '하이링크'를 인수했다. 소프트뱅크 계열 LY코퍼레이션이 최대 주주다.","summary_md":"- **판정 부진.** 7~9월 주당순이익 11.29엔은 애널리스트 3명 평균 12.03엔보다 6.1% 적었다. 매출 545.1억엔은 10명 평균 544.3억엔과 같았다. 연간 계획은 그대로다.\n- 조조타운 거래액(상품 판매 총액)은 1,199억엔으로 5.2% 늘었다. 회사는 날씨가 선선해 여름옷 수요가 약했고 계획에 조금 못 미쳤다고 밝혔다. 야후 쇼핑 입점분은 1년 전보다 15.9% 늘었다.\n- 영업이익은 149억엔으로 5.6% 늘었다. 배송비·물류비 비율은 내려갔지만 광고·판촉비와 감가상각비, 영국 리스트 비용이 늘었다.\n- 순이익은 98.6억엔으로 2.3% 늘어 영업이익보다 덜 늘었다. 세금 부담률이 올라간 영향이다.\n- 연간 계획은 매출 2,419억엔(+5.9%), 영업이익 744억엔(+7.3%)을 유지했다. 4~9월 경상이익 진척률은 44.2%로 최근 5년 평균 47.3%보다 3.1%포인트 낮다.\n- 자사주를 6월 이후 191.6억엔어치 샀고, 산 주식은 2027년 1월 모두 없앤다. 발표 날 종가는 1,173엔(−0.2%)이었다."}}