3.0,"timing":"intraday","time_known":true,"d1":0.7,"d1_d":"2026-10-14","d5":-1.1,"d5_d":"2026-10-20"}},"qs":[{"label":"24.09-11","cq":"4Q24","rev":12912.0,"op":715.0,"ni":653.0,"opm":5.5,"yoy":{"rev":-0.7,"op":0.1,"ni":33.8},"qoq":{"rev":8.5,"op":6.7,"ni":24.1}},{"label":"24.12-02","cq":"1Q25","rev":12161.0,"op":617.0,"ni":601.0,"opm":5.1,"yoy":{"rev":3.9,"op":-6.9,"ni":6.4},"qoq":{"rev":-5.8,"op":-13.7,"ni":-8.0}},{"label":"25.03-05","cq":"2Q25","rev":13644.0,"op":951.0,"ni":1745.0,"opm":7.0,"yoy":{"rev":13.7,"op":15.8,"ni":110.5},"qoq":{"rev":12.2,"op":54.1,"ni":190.3}},{"label":"25.06-08","cq":"3Q25","rev":14790.0,"op":809.0,"ni":673.0,"opm":5.5,"yoy":{"rev":24.3,"op":20.7,"ni":27.9},"qoq":{"rev":8.4,"op":-14.9,"ni":-61.4}},{"label":"25.09-11","cq":"4Q25","rev":16272.0,"op":956.0,"ni":-103.0,"opm":5.9,"yoy":{"rev":26.0,"op":33.7,"ni":-115.8},"qoq":{"rev":10.0,"op":18.2,"ni":-115.3}},{"label":"25.12-02","cq":"1Q26","rev":16681.0,"op":1038.0,"ni":660.0,"opm":6.2,"yoy":{"rev":37.2,"op":68.2,"ni":9.8},"qoq":{"rev":2.5,"op":8.6,"ni":null}},{"label":"26.03-05","cq":"2Q26","rev":16387.0,"op":1020.0,"ni":985.0,"opm":6.2,"yoy":{"rev":20.1,"op":7.3,"ni":-43.6},"qoq":{"rev":-1.8,"op":-1.7,"ni":49.2}},{"label":"26.06-08","cq":"3Q26","rev":16237.0,"op":859.0,"ni":721.0,"opm":5.3,"yoy":{"rev":9.8,"op":6.2,"ni":7.1},"qoq":{"rev":-0.9,"op":-15.8,"ni":-26.8}}],"note":{"headline":"연간 전망 상향(양호) — 6~8월 매출 +9.8%·영업이익 +6.2%, 아시아 의류 부자재와 생활용품이 끌었지만 일본 의류 부자재는 줄고 이익률은 낮아졌다","about":"1908년 오사카에서 구두끈 구멍쇠·똑딱단추 중개로 시작한 옷·신발 부자재 전문 상사 겸 제조사. 금속 똑딱단추는 일본 1위, 세계 1~2위이고 매직테이프·단추·끈을 의류·신발·가방 회사에 판다.\n매출의 약 60%가 의류 부자재, 30%가 건강·생활용품과 주방 배기필터 대여 같은 제품 사업, 10%가 자동차 내장 부품이다. 매출의 73%가 일본에서 나오고 최근 인수합병으로 덩치를 키우고 있다.","summary_md":"- **연간 전망 상향(양호).** 6~8월(3Q26, 2026년 11월기 3분기) 영업이익은 8.6억엔으로 전년보다 6.2% 늘었다. 회사는 연간 영업이익 전망을 35억엔에서 36억엔으로 올렸다.\n- 매출은 162.4억엔으로 9.8% 늘었다. 애널리스트 1명의 추정치 153.1억엔보다 6% 많다. 지난해 인수한 두 회사와 4월 인수한 히사나가 제작소가 매출을 보탰다.\n- 아시아 매출이 35% 늘었다. 중국 캐주얼 의류와 베트남 운동화용 부자재가 잘 팔렸다. 일본은 건강·생활용품과 주방 기기 서비스가 늘었지만 의류 부자재는 2.4% 줄었다.\n- 영업이익률은 5.3%로 전년보다 0.2%포인트 낮다. 직전 분기 6.2%에서도 내려왔다. 팬 달린 작업복과 온라인 패션 판매가 6월 이후 멈췄다고 회사가 밝혔다.\n- 경상이익 기준 연간 진척률은 81.8%로 최근 2년 평균 74.4%보다 7.4%포인트 높다. 다만 상향 뒤 전망대로면 9~11월 영업이익은 6.8억엔으로 전년보다 29% 적다.\n- 다음 기부터 누진 배당과 자기자본 대비 배당 5% 기준을 도입한다. 주가는 발표 뒤 플러스로 돌아서 0.7% 오른 1,845엔에 마감했다."}}