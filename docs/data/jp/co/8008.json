2135.0,"timing":"after","time_known":true,"d1":-5.1,"d1_d":"2026-10-13","d5":-6.2,"d5_d":"2026-10-19"}},"qs":[{"label":"24.09-11","cq":"4Q24","rev":9733.0,"op":317.0,"ni":337.0,"opm":3.3,"yoy":{"rev":1.5,"op":18.3,"ni":null},"qoq":{"rev":-0.4,"op":8.2,"ni":null}},{"label":"24.12-02","cq":"1Q25","rev":16709.0,"op":808.0,"ni":369.0,"opm":4.8,"yoy":{"rev":54.7,"op":6.5,"ni":null},"qoq":{"rev":71.7,"op":154.9,"ni":9.5}},{"label":"25.03-05","cq":"2Q25","rev":15659.0,"op":549.0,"ni":422.0,"opm":3.5,"yoy":{"rev":61.6,"op":1.3,"ni":null},"qoq":{"rev":-6.3,"op":-32.1,"ni":14.4}},{"label":"25.06-08","cq":"3Q25","rev":16815.0,"op":575.0,"ni":359.0,"opm":3.4,"yoy":{"rev":72.1,"op":96.2,"ni":null},"qoq":{"rev":7.4,"op":4.7,"ni":-14.9}},{"label":"25.09-11","cq":"4Q25","rev":18317.0,"op":796.0,"ni":465.0,"opm":4.3,"yoy":{"rev":88.2,"op":151.1,"ni":38.0},"qoq":{"rev":8.9,"op":38.4,"ni":29.5}},{"label":"25.12-02","cq":"1Q26","rev":19171.0,"op":882.0,"ni":546.0,"opm":4.6,"yoy":{"rev":14.7,"op":9.2,"ni":48.0},"qoq":{"rev":4.7,"op":10.8,"ni":17.4}},{"label":"26.03-05","cq":"2Q26","rev":19961.0,"op":1283.0,"ni":769.0,"opm":6.4,"yoy":{"rev":27.5,"op":133.7,"ni":82.2},"qoq":{"rev":4.1,"op":45.5,"ni":40.8}},{"label":"26.06-08","cq":"3Q26","rev":19481.0,"op":1426.0,"ni":788.0,"opm":7.3,"yoy":{"rev":15.9,"op":148.0,"ni":119.5},"qoq":{"rev":-2.4,"op":11.1,"ni":2.5}}],"note":{"headline":"6~8월(3Q26) 영업이익 2.5배 — 욘도시 주얼리 기존점 매달 +11~21%와 라신이 끌었지만, 4.5억엔은 퇴직급여 일회성 이익이고 의류 본업은 줄었다","about":"보석 브랜드 「욘도시(4℃)」를 직접 만들어 파는 주얼리 체인과, 2024년 12월 인수한 고급 시계 중고 판매점 「긴자 라신」을 묶은 브랜드 사업이 매출의 3분의 2를 차지한다.\n나머지는 의류 위탁 생산(아스티)과 저가 의류 체인 「파레트」(아쥬)를 하는 의류 사업이다. 회사는 대외적으로 '4℃ 홀딩스'라는 이름을 쓴다.","summary_md":"- **매출이 16% 늘고 영업이익은 2.5배가 됐다.** 3Q26(6~8월, 2027년 2월기 2분기) 매출은 194.8억엔(+15.9%), 영업이익은 14.3억엔(+148%)이다. 영업이익률은 3.4%에서 7.3%로 올랐다.\n- **이익의 3분의 1은 일회성이다.** 자회사 아스티가 퇴직연금 제도를 바꾸면서 비용 4.5억엔이 줄었다. 이를 빼면 영업이익은 9.7억엔(+69%), 이익률은 5.0%다.\n- **보석과 시계가 성장을 이끌었다.** 브랜드 사업 매출은 133.8억엔(+25.9%), 영업이익은 10.2억엔으로 두 배가 됐다. 회사 월차로 보면 욘도시 주얼리 기존점은 6~8월 매달 11~21% 늘었다.\n- **의류 사업은 실제로는 나빠졌다.** 매출은 61.0억엔(−1.4%)이다. 일회성을 빼면 영업이익이 2.3억엔으로 38% 줄었다. 회사는 엔화 약세와 원가 상승을 이유로 들었다.\n- **회사 계획은 크게 넘었다.** 7월에 낸 계획으로 따지면 6~8월 매출은 11%, 영업이익은 17% 많았다. 회사는 연간 매출 전망만 770억엔으로 올리고 이익 전망(영업이익 43억엔)은 유지했다.\n- **남은 두 분기 계획은 낮게 잡혔다.** 연간 계획을 맞추려면 9~2월 영업이익은 15.9억엔이면 된다. 전년 같은 기간보다 5% 적은 숫자다."}}