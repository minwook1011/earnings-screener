6.0,"op":150333.0,"ni":121911.0,"opm":8.3,"yoy":{"rev":-1.4,"op":460.9,"ni":null},"qoq":{"rev":5.4,"op":15.0,"ni":null}},{"label":"25.01-03","cq":"1Q25","rev":1873329.0,"op":117393.0,"ni":106333.0,"opm":6.3,"yoy":{"rev":4.7,"op":-17.3,"ni":null},"qoq":{"rev":3.3,"op":-21.9,"ni":-12.8}},{"label":"25.04-06","cq":"2Q25","rev":1754137.0,"op":107205.0,"ni":79268.0,"opm":6.1,"yoy":{"rev":0.2,"op":-11.1,"ni":null},"qoq":{"rev":-6.4,"op":-8.7,"ni":-25.5}},{"label":"25.07-09","cq":"3Q25","rev":1836330.0,"op":104212.0,"ni":52089.0,"opm":5.7,"yoy":{"rev":6.8,"op":-20.3,"ni":null},"qoq":{"rev":4.7,"op":-2.8,"ni":-34.3}},{"label":"25.10-12","cq":"4Q25","rev":1905061.0,"op":164462.0,"ni":142317.0,"opm":8.6,"yoy":{"rev":5.0,"op":9.4,"ni":16.7},"qoq":{"rev":3.7,"op":57.8,"ni":173.2}},{"label":"26.01-03","cq":"1Q26","rev":2044447.0,"op":176659.0,"ni":170081.0,"opm":8.6,"yoy":{"rev":9.1,"op":50.5,"ni":60.0},"qoq":{"rev":7.3,"op":7.4,"ni":19.5}},{"label":"26.04-06","cq":"2Q26","rev":1913868.0,"op":84178.0,"ni":67875.0,"opm":4.4,"yoy":{"rev":9.1,"op":-21.5,"ni":-14.4},"qoq":{"rev":-6.4,"op":-52.4,"ni":-60.1}},{"label":"26.07-09","cq":"3Q26","rev":1929682.0,"op":85969.0,"ni":51919.0,"opm":4.5,"yoy":{"rev":5.1,"op":-17.5,"ni":-0.3},"qoq":{"rev":0.8,"op":2.1,"ni":-23.5}}],"note":{"headline":"부진 — 7~9월(3Q26) 매출 +5.1%에도 영업이익 860억엔(−17.5%)·이익률 4.5%. 일본 이익은 두 배로 늘었지만 북미·아시아가 크게 줄었고, 연간 계획 유지와 함께 자사주 2,000억엔 매입을 내놓았다","about":"일본 최대 자동차 부품 회사로, 도요타 그룹의 핵심 부품사다. 엔진·하이브리드 제어, 전동화 부품(인버터·모터), 에어컨 같은 열 관리, 운전 보조 센서·전자 제어 장치를 만든다.\n최대 고객은 도요타 그룹이고, 일본·북미·유럽·아시아 공장에서 세계 완성차 회사에 납품한다. 회계는 국제회계기준을 쓴다.","summary_md":"- **판정 부진.** 3Q26(7~9월, 2027년 3월기 2분기) 영업이익은 860억엔으로 1년 전 1,042억엔보다 17.5% 줄었다. 분기 주당이익 약 20.9엔은 애널리스트 2명 평균 예상(29.0엔)보다 약 28% 적었다.\n- 매출은 19,297억엔(+5.1%)으로 야후 컨센서스(18,874억엔)보다 2.2% 많았다. 회사는 차량 판매 증가, 전동화·안전 제품 장착 확대, 엔화 약세를 이유로 들었다.\n- 이익을 깎은 것은 부품·재료값 상승, 미래를 위한 개발비, 1년 전 일회성 이익이 빠진 것이다. 매출총이익률은 13.6%로 1.4%p 내렸다.\n- 지역별로는 일본 영업이익이 415억엔으로 2.3배가 됐다. 반면 북미(142억엔, −59%)와 아시아(273억엔, −44%)는 크게 줄었다.\n- **연간 계획(매출 77,500억엔·영업이익 5,000억엔) 유지.** 남은 두 분기에 영업이익 3,299억엔이 필요하다. 1년 전 같은 기간보다 3.3% 적지만, 분기마다 7~9월의 두 배 가까운 이익을 내야 한다.\n- 같은 날 자사주 최대 1억주·2,000억엔 매입과 4억주(발행 주식의 13.74%) 소각을 발표했다. 오전장 종가는 1,850엔으로 전날보다 2.3% 높았다."}}