:3913.0,"timing":"after","time_known":false,"d1":null,"d1_d":null,"d5":null,"d5_d":null}},"qs":[{"label":"24.10-12","cq":"4Q24","rev":87849.0,"op":7113.0,"ni":5277.0,"opm":8.1,"yoy":{"rev":4.3,"op":-14.9,"ni":-7.1},"qoq":{"rev":5.8,"op":10.1,"ni":24.5}},{"label":"25.01-03","cq":"1Q25","rev":89686.0,"op":8897.0,"ni":6470.0,"opm":9.9,"yoy":{"rev":-2.2,"op":2.3,"ni":10.8},"qoq":{"rev":2.1,"op":25.1,"ni":22.6}},{"label":"25.04-06","cq":"2Q25","rev":81828.0,"op":7884.0,"ni":4911.0,"opm":9.6,"yoy":{"rev":-0.8,"op":5.1,"ni":-33.6},"qoq":{"rev":-8.8,"op":-11.4,"ni":-24.1}},{"label":"25.07-09","cq":"3Q25","rev":81928.0,"op":11268.0,"ni":7234.0,"opm":13.8,"yoy":{"rev":-1.3,"op":74.4,"ni":70.6},"qoq":{"rev":0.1,"op":42.9,"ni":47.3}},{"label":"25.10-12","cq":"4Q25","rev":87768.0,"op":7578.0,"ni":6725.0,"opm":8.6,"yoy":{"rev":-0.1,"op":6.5,"ni":27.4},"qoq":{"rev":7.1,"op":-32.7,"ni":-7.0}},{"label":"26.01-03","cq":"1Q26","rev":97952.0,"op":10341.0,"ni":3337.0,"opm":10.6,"yoy":{"rev":9.2,"op":16.2,"ni":-48.4},"qoq":{"rev":11.6,"op":36.5,"ni":-50.4}},{"label":"26.04-06","cq":"2Q26","rev":85654.0,"op":6076.0,"ni":5204.0,"opm":7.1,"yoy":{"rev":4.7,"op":-22.9,"ni":6.0},"qoq":{"rev":-12.6,"op":-41.2,"ni":55.9}},{"label":"26.07-09","cq":"3Q26","rev":93022.0,"op":7488.0,"ni":4777.0,"opm":8.0,"yoy":{"rev":13.5,"op":-33.5,"ni":-34.0},"qoq":{"rev":8.6,"op":23.2,"ni":-8.2}}],"note":{"headline":"연간 계획 속도에 못 미친 부진 — 7~9월(3Q26) 매출 +13.5%·영업이익 −33.5%. 나프타 값이 67% 뛰어 화학품 이익이 절반 넘게 줄었다. 진단 사업 인수로 매출은 시장 예상과 맞았고, 순이익 계획 상향은 시멘트 사업 매각 이익 덕","about":"일본 야마구치현 슈난에 큰 화학 공장을 둔 소재 회사다. 소금을 전기분해해 만드는 가성소다·염화비닐 같은 기초 화학품, 시멘트, 반도체용 고순도 다결정 실리콘·반도체 약품·방열 소재, 치과 재료·진단 시약을 판다.\n이익은 원료 나프타 값과 반도체 경기, 그리고 2025년 10월 사들인 진단 사업(도쿠야마 라이프사이언스) 같은 성장 사업이 얼마나 빨리 크느냐에 따라 움직인다.","summary_md":"- **영업이익이 연간 계획 속도에 못 미쳐 '부진'**: 3Q26(7~9월, 2027년 3월기 2분기) 매출 **930억엔(+13.5%)**, 영업이익 **74.9억엔(−33.5%)**, 영업이익률 **8.0%**(전년 13.8%). 매출은 애널리스트 1명의 예상(923억엔)과 거의 같았다.\n- **이익이 준 이유는 원료값**: 회사가 밝힌 4~9월 국산 나프타 값은 킬로리터당 10만7,700엔으로 전년보다 67% 올랐다. 화학품 영업이익은 11.6억엔으로 59% 줄었다.\n- **반도체 소재도 감익**: 전자 첨단재료 매출은 13.6% 늘었지만 다결정 실리콘 판매가 줄고 재고 평가손이 커져 영업이익이 12.5% 줄었다. 시멘트도 출하 감소와 석탄값 상승으로 26.5% 감익.\n- **버틴 곳은 라이프사이언스**: 2025년 10월 인수한 진단 사업이 더해져 매출 +40.9%, 영업이익 +15.3%. 직전 분기(4~6월)보다 영업이익은 23% 늘었다.\n- **연간 계획**: 매출 3,920억엔·영업이익 340억엔 유지. 4~9월 영업이익 진척률은 39.9%로, 10~3월 두 분기에 204억엔(전년 같은 기간 대비 +14%)이 필요하다. 순이익은 시멘트 매각 이익으로 465억엔(+79%)으로 올렸다.\n- **배당**: 기말 배당을 72엔에서 80엔으로 올려 연간 140엔(전년 120엔). 주가는 발표 당일 오전장을 3,883엔(−1.3%)으로 마쳤다."}}