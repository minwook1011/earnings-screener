05.0,"op":554.0,"ni":403.0,"opm":0.9,"yoy":{"rev":3.8,"op":163.8,"ni":117.8},"qoq":{"rev":-12.5,"op":-70.2,"ni":-46.2}},{"label":"24.12-02","cq":"1Q25","rev":74362.0,"op":2886.0,"ni":2088.0,"opm":3.9,"yoy":{"rev":7.1,"op":45.8,"ni":44.0},"qoq":{"rev":19.4,"op":420.9,"ni":418.1}},{"label":"25.03-05","cq":"2Q25","rev":73456.0,"op":2077.0,"ni":1483.0,"opm":2.8,"yoy":{"rev":6.0,"op":-10.1,"ni":-8.5},"qoq":{"rev":-1.2,"op":-28.0,"ni":-29.0}},{"label":"25.06-08","cq":"3Q25","rev":72667.0,"op":1808.0,"ni":735.0,"opm":2.5,"yoy":{"rev":2.1,"op":-2.8,"ni":-1.9},"qoq":{"rev":-1.1,"op":-13.0,"ni":-50.4}},{"label":"25.09-11","cq":"4Q25","rev":65668.0,"op":1211.0,"ni":832.0,"opm":1.8,"yoy":{"rev":5.4,"op":118.6,"ni":106.5},"qoq":{"rev":-9.6,"op":-33.0,"ni":13.2}},{"label":"25.12-02","cq":"1Q26","rev":78269.0,"op":2863.0,"ni":1987.0,"opm":3.7,"yoy":{"rev":5.3,"op":-0.8,"ni":-4.8},"qoq":{"rev":19.2,"op":136.4,"ni":138.8}},{"label":"26.03-05","cq":"2Q26","rev":78887.0,"op":3328.0,"ni":2369.0,"opm":4.2,"yoy":{"rev":7.4,"op":60.2,"ni":59.7},"qoq":{"rev":0.8,"op":16.2,"ni":19.2}},{"label":"26.06-08","cq":"3Q26","rev":74808.0,"op":1220.0,"ni":341.0,"opm":1.6,"yoy":{"rev":2.9,"op":-32.5,"ni":-53.6},"qoq":{"rev":-5.2,"op":-63.3,"ni":-85.6}}],"note":{"headline":"6~8월(3Q26) 매출 +2.9%·영업이익 −32.5% — 5월 에어컨 특수 뒤 할인·경비가 늘어 이익이 꺾였지만 회사 계획은 넘겼고, 새해 영업이익은 +4.4% 전망","about":"수도권(점포의 절반)과 북간토를 중심으로 138개 점포를 둔 일본 가전 양판점. 2012년부터 빅카메라 그룹 자회사로, 점포 이름을 「코지마×빅카메라」로 바꿔 모회사와 함께 운영한다.\n매출은 생활가전(42%)·정보통신기기(31%, 그중 휴대폰 16%)·영상음향(13%) 순이고, 매장 외에 온라인몰(매출의 13%)·법인 영업(5%)·주택설비 공사를 키우고 있다.","summary_md":"- **매출은 3% 늘었지만 영업이익은 3분의 1이 줄었다.** 6~8월(3Q26, 회사 기준 2026년 8월기 4분기) 매출은 748억엔(+2.9%), 영업이익은 12.2억엔(−32.5%)이다. 영업이익률은 1.6%로 전년(2.5%)보다 낮다.\n- **에어컨과 휴대폰이 매출을 받쳤다.** 에어컨 매출이 127억엔으로 25% 늘었다. 휴대폰은 15% 늘었다. 반면 게임은 48% 줄었다. 닌텐도 스위치 2 값이 5월에 1만엔 오르고, 전년 발매 효과가 사라진 탓이다.\n- **매출총이익률은 27.8%로 0.6%p 올랐다.** 그런데 판관비가 9.0%(16억엔) 늘어 이익을 다 먹었다. 온라인몰 쿠폰 같은 판촉비가 53% 늘었고, 그 밖의 경비도 21% 늘었다.\n- **회사 계획보다는 좋았다.** 7월에 유지한 연간 계획으로 따지면 6~8월 영업이익은 8억엔이면 됐다. 실제는 12.2억엔이다. 연간 영업이익 86억엔은 계획(82억엔)보다 5% 많다.\n- **새해(2026년 9월~2027년 8월) 전망은 낮게 잡았다.** 매출 3,000억엔(+0.8%), 영업이익 90억엔(+4.4%)이다. 배당은 1엔 늘려 30엔이다.\n- **주가 반응은 아직 없다.** 발표는 10/8 장 마감 뒤였다. 이날 종가 1,410엔은 새해 예상 주당이익의 약 19배다."}}