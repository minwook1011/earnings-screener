":32451.0,"op":10294.0,"ni":7791.0,"opm":31.7,"yoy":{"rev":4.0,"op":-25.9,"ni":-16.7},"qoq":{"rev":21.1,"op":31.3,"ni":47.0}},{"label":"25.01-03","cq":"1Q25","rev":80751.0,"op":34757.0,"ni":25387.0,"opm":43.0,"yoy":{"rev":74.8,"op":270.5,"ni":190.5},"qoq":{"rev":148.8,"op":237.6,"ni":225.9}},{"label":"25.04-06","cq":"2Q25","rev":45502.0,"op":24597.0,"ni":17238.0,"opm":54.1,"yoy":{"rev":53.7,"op":90.7,"ni":72.7},"qoq":{"rev":-43.7,"op":-29.2,"ni":-32.1}},{"label":"25.07-09","cq":"3Q25","rev":35650.0,"op":14736.0,"ni":10276.0,"opm":41.3,"yoy":{"rev":33.0,"op":88.0,"ni":93.9},"qoq":{"rev":-21.7,"op":-40.1,"ni":-40.4}},{"label":"25.10-12","cq":"4Q25","rev":34163.0,"op":14969.0,"ni":11371.0,"opm":43.8,"yoy":{"rev":5.3,"op":45.4,"ni":46.0},"qoq":{"rev":-4.2,"op":1.6,"ni":10.7}},{"label":"26.01-03","cq":"1Q26","rev":80050.0,"op":20993.0,"ni":15702.0,"opm":26.2,"yoy":{"rev":-0.9,"op":-39.6,"ni":-38.1},"qoq":{"rev":134.3,"op":40.2,"ni":38.1}},{"label":"26.04-06","cq":"2Q26","rev":70410.0,"op":41054.0,"ni":29159.0,"opm":58.3,"yoy":{"rev":54.7,"op":66.9,"ni":69.2},"qoq":{"rev":-12.0,"op":95.6,"ni":85.7}},{"label":"26.07-09","cq":"3Q26","rev":50477.0,"op":19715.0,"ni":13924.0,"opm":39.1,"yoy":{"rev":41.6,"op":33.8,"ni":35.5},"qoq":{"rev":-28.3,"op":-52.0,"ni":-52.2}}],"note":{"headline":"컨센서스 소폭 상회(양호) — 7~9월(3Q26) 매출 42%·영업이익 34% 늘었다. 신작 『귀무자』와 바이오하자드 옛 게임이 끌었지만 이익률은 39.1%로 내려갔고, 연간 계획은 진척률 74%에도 그대로 뒀다","about":"일본 게임 회사. 『바이오하자드』『몬스터 헌터』『스트리트 파이터』『데빌 메이 크라이』 같은 자체 시리즈를 만들어 세계 약 240개 나라·지역에 판다. 게임 판매의 약 90%가 내려받기(디지털)이고, 매출 대부분이 해외에서 나온다.\n발매 몇 년 지난 옛 게임을 값을 내려 꾸준히 다시 파는 것이 이익의 핵심이다(지난해 판매량의 84%). 오락실 운영, 파친코·슬롯기 판매, 영화·애니메이션·캐릭터 상품도 한다.","summary_md":"- **양호**: 7~9월(3Q26, 회사 기준 2027년 3월기 2분기) 매출 **504.8억엔(+41.6%)**, 영업이익 **197.2억엔(+33.8%)**. 매출은 애널리스트 10명 평균 483.5억엔보다 4.4% 많았고, 4~9월 경상이익은 카부요호 컨센서스보다 3.3% 많았다.\n- 성장은 게임 판매량에서 나왔다. 7~9월 판매량은 1,305만 개로 35% 늘었다. 9월 4일 낸 『귀무자: 웨이 오브 더 소드』가 170만 개 팔렸고, 옛 게임도 1,092만 개로 15% 늘었다.\n- 영업이익률은 39.1%로 1년 전 41.3%보다 2.2%p 내려갔다. 매출총이익률이 61.3%에서 56.3%로 떨어졌고 판관비도 22% 늘었다. 회사는 이유를 따로 설명하지 않았다.\n- 오락실(+31%)과 파친코·슬롯기(+28%)도 매출이 늘었다. 9월에 출하한 『몬스터 헌터 라이즈: 선브레이크』 슬롯기 1.4만 대가 실적에 들어왔다.\n- 연간 계획(매출 2,100억엔·영업이익 830억엔)은 유지했다. 4~9월에 영업이익 계획의 73.2%를 벌어, 계획대로라면 10~3월 두 분기 영업이익은 1년 전보다 38% 적다.\n- 주가는 발표 날 종가 4,380엔. 카부탄 기준 발표 직후 시간외 거래는 4,133엔(−5.6%)이었다. 주당순이익은 애널리스트 3명 평균보다 14% 낮았다."}}