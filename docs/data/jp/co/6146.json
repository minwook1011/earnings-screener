,"est":459.93,"pct":-7.5},"px":{"base_d":"2026-10-22","base":51230.0,"timing":"after","time_known":true,"d1":-3.8,"d1_d":"2026-10-23","d5":2.1,"d5_d":"2026-10-29"}},"qs":[{"label":"24.10-12","cq":"4Q24","rev":93553.0,"op":39146.0,"ni":31809.0,"opm":41.8,"yoy":{"rev":21.5,"op":28.8,"ni":97.6},"qoq":{"rev":-2.8,"op":-8.1,"ni":7.1}},{"label":"25.01-03","cq":"1Q25","rev":120717.0,"op":51736.0,"ni":38639.0,"opm":42.9,"yoy":{"rev":15.7,"op":12.2,"ni":9.1},"qoq":{"rev":29.0,"op":32.2,"ni":21.5}},{"label":"25.04-06","cq":"2Q25","rev":89914.0,"op":34480.0,"ni":23767.0,"opm":38.3,"yoy":{"rev":8.6,"op":3.2,"ni":0.3},"qoq":{"rev":-25.5,"op":-33.4,"ni":-38.5}},{"label":"25.07-09","cq":"3Q25","rev":104623.0,"op":44391.0,"ni":32146.0,"opm":42.4,"yoy":{"rev":8.8,"op":4.2,"ni":8.2},"qoq":{"rev":16.4,"op":28.7,"ni":35.3}},{"label":"25.10-12","cq":"4Q25","rev":109291.0,"op":47341.0,"ni":36726.0,"opm":43.3,"yoy":{"rev":16.8,"op":20.9,"ni":15.5},"qoq":{"rev":4.5,"op":6.6,"ni":14.2}},{"label":"26.01-03","cq":"1Q26","rev":133061.0,"op":58777.0,"ni":42882.0,"opm":44.2,"yoy":{"rev":10.2,"op":13.6,"ni":11.0},"qoq":{"rev":21.7,"op":24.2,"ni":16.8}},{"label":"26.04-06","cq":"2Q26","rev":114308.0,"op":49033.0,"ni":34221.0,"opm":42.9,"yoy":{"rev":27.1,"op":42.2,"ni":44.0},"qoq":{"rev":-14.1,"op":-16.6,"ni":-20.2}},{"label":"26.07-09","cq":"3Q26","rev":142750.0,"op":67606.0,"ni":46145.0,"opm":47.4,"yoy":{"rev":36.4,"op":52.3,"ni":43.5},"qoq":{"rev":24.9,"op":37.9,"ni":34.8}}],"note":{"headline":"부합 — 회사 계획은 크게 넘었지만, 애널리스트 이익 추정엔 못 미치고 다음 분기 전망도 낮다","about":"반도체 웨이퍼를 자르는 다이서와 얇게 갈아내는 그라인더 같은 정밀가공 장비, 그리고 그 장비에 끼워 쓰는 소모품(다이싱 블레이드·연삭 휠)을 만드는 일본 회사다.\n매출의 약 90%가 해외(대만·중국·한국 등 아시아)에서 나오고, 인공지능 반도체와 고대역폭 메모리 생산이 늘수록 장비와 소모품이 함께 팔린다.","summary_md":"- **판정 부합.** 7~9월 영업이익 676억엔은 7월 회사 계획 559억엔을 21% 넘었다. 다만 주당순이익 425엔은 애널리스트 6명 평균 460엔보다 7.5% 낮았다.\n- 매출 1,428억엔(전년 대비 +36%), 영업이익 676억엔(+52%). 영업이익률은 47.4%로 1년 전보다 5.0%포인트 올랐다.\n- 출하액 1,486억엔으로 사상 최대. 소모품(정밀가공 툴) 출하가 직전 분기보다 24% 늘며 최고치를 다시 썼다.\n- 매출총이익률 71.7%. 회사는 엔화 약세 효과와 값비싼 제품 비중 확대를 이유로 들었다.\n- 10~12월 회사 전망은 매출 1,324억엔, 영업이익 581억엔. 애널리스트 매출 추정 1,453억엔보다 9% 낮고, 가정 환율도 159엔에서 151엔으로 낮췄다.\n- 중간배당 186엔(전년 129엔). 장 마감 뒤 발표라 주가 반응은 10월 23일부터."}}