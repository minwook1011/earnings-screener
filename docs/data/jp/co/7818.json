.0,"op":1544.0,"ni":1045.0,"opm":21.7,"yoy":{"rev":7.3,"op":3.6,"ni":4.5},"qoq":{"rev":15.7,"op":23.5,"ni":3.5}},{"label":"24.12-02","cq":"1Q25","rev":6403.0,"op":1180.0,"ni":921.0,"opm":18.4,"yoy":{"rev":4.5,"op":-1.7,"ni":3.6},"qoq":{"rev":-9.9,"op":-23.6,"ni":-11.9}},{"label":"25.03-05","cq":"2Q25","rev":7264.0,"op":1557.0,"ni":1075.0,"opm":21.4,"yoy":{"rev":18.3,"op":19.8,"ni":25.1},"qoq":{"rev":13.4,"op":31.9,"ni":16.7}},{"label":"25.06-08","cq":"3Q25","rev":6680.0,"op":1425.0,"ni":1037.0,"opm":21.3,"yoy":{"rev":8.8,"op":14.0,"ni":2.7},"qoq":{"rev":-8.0,"op":-8.5,"ni":-3.5}},{"label":"25.09-11","cq":"4Q25","rev":7966.0,"op":1826.0,"ni":1222.0,"opm":22.9,"yoy":{"rev":12.1,"op":18.3,"ni":16.9},"qoq":{"rev":19.3,"op":28.1,"ni":17.8}},{"label":"25.12-02","cq":"1Q26","rev":6879.0,"op":1340.0,"ni":895.0,"opm":19.5,"yoy":{"rev":7.4,"op":13.6,"ni":-2.8},"qoq":{"rev":-13.6,"op":-26.6,"ni":-26.8}},{"label":"26.03-05","cq":"2Q26","rev":8299.0,"op":1735.0,"ni":1260.0,"opm":20.9,"yoy":{"rev":14.2,"op":11.4,"ni":17.2},"qoq":{"rev":20.6,"op":29.5,"ni":40.8}},{"label":"26.06-08","cq":"3Q26","rev":8374.0,"op":1498.0,"ni":1152.0,"opm":17.9,"yoy":{"rev":25.4,"op":5.1,"ni":11.1},"qoq":{"rev":0.9,"op":-13.7,"ni":-8.6}}],"note":{"headline":"부합 — 최애 굿즈 대형 주문으로 매출은 25% 뛰었지만, 원가율 상승과 인수 회사 탓에 영업이익은 5% 증가에 그쳤다","about":"기업이 판촉물·기념품·굿즈로 쓰는 에코백, 텀블러, 우산, 파우치 같은 생활잡화를 기획해 중국·동남아 공장에 맡겨 만들고, 일본 자체 공장에서 로고·그림을 인쇄해 파는 회사다.\n공장을 갖지 않고 생산지를 그때그때 옮기는 방식(회사는 '이동형 팹리스'라 부른다)과 기업용 인터넷몰이 강점이고, 최근에는 게임·애니메이션·음악 업계의 '최애 응원(오시카쓰)' 굿즈 주문이 성장을 끌고 있다.","summary_md":"- **회사 계획 대비 부합.** 6~8월(회사 기준 8월기 4분기) 영업이익은 15.0억엔으로 4월 수정 계획이 남겨 둔 몫(14.0억엔)을 7% 넘었다. 다만 10월 8일 예상 상향으로 숫자가 미리 나왔고, 이익률이 크게 떨어져 한 단계 낮춰 봤다.\n- **매출은 83.7억엔으로 전년보다 25.4% 늘었다.** 게임·애니메이션·음악 업계의 굿즈 대형 주문으로 생활용품 부문이 43% 늘었다. 4월부터 넣은 피규어 회사 두 곳 매출도 보탰다.\n- **영업이익률은 21.3%에서 17.9%로 3.4%포인트 내려갔다.** 매출총이익률이 41.1%에서 37.6%로 떨어진 탓이다. 회사는 인수한 두 회사의 낮은 이익률과 인건비 투자를 이유로 들었고, 기존 회사만 보면 20.0%였다고 밝혔다.\n- **값싼 제품 쪽으로 주문이 옮겨 갔다.** 에코백 등 친환경 제품 매출은 1.6% 늘어 거의 제자리였다. 회사는 중동 정세 불안으로 기업들이 판촉 예산을 아낀 영향이라고 설명했다.\n- **다음 기(2027년 8월기)는 매출 370억엔(+17.4%), 영업이익 71.7억엔(+12.0%) 계획이다.** 판관비가 20% 늘어 이익률은 19.4%로 더 낮아진다. 9~2월 두 분기 영업이익 증가율은 3.9%로 잡았다.\n- **주가는 발표가 장 마감 뒤라 아직 반응 전이다.** 발표 당일 종가 1,231엔은 다음 기 회사 예상 주당순이익 기준 14배 수준이다."}}