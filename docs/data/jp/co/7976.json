.0,"op":4478.0,"ni":3647.0,"opm":17.3,"yoy":{"rev":19.4,"op":19.1,"ni":-7.4},"qoq":{"rev":26.4,"op":75.6,"ni":271.8}},{"label":"25.01-03","cq":"1Q25","rev":22588.0,"op":2556.0,"ni":1459.0,"opm":11.3,"yoy":{"rev":12.4,"op":-16.7,"ni":-31.8},"qoq":{"rev":-12.8,"op":-42.9,"ni":-60.0}},{"label":"25.04-06","cq":"2Q25","rev":20657.0,"op":2243.0,"ni":1685.0,"opm":10.9,"yoy":{"rev":-7.8,"op":6.8,"ni":-62.6},"qoq":{"rev":-8.5,"op":-12.2,"ni":15.5}},{"label":"25.07-09","cq":"3Q25","rev":20836.0,"op":1748.0,"ni":848.0,"opm":8.4,"yoy":{"rev":1.6,"op":-31.5,"ni":-13.6},"qoq":{"rev":0.9,"op":-22.1,"ni":-49.7}},{"label":"25.10-12","cq":"4Q25","rev":25733.0,"op":3145.0,"ni":2243.0,"opm":12.2,"yoy":{"rev":-0.7,"op":-29.8,"ni":-38.5},"qoq":{"rev":23.5,"op":79.9,"ni":164.5}},{"label":"26.01-03","cq":"1Q26","rev":24710.0,"op":3566.0,"ni":2464.0,"opm":14.4,"yoy":{"rev":9.4,"op":39.5,"ni":68.9},"qoq":{"rev":-4.0,"op":13.4,"ni":9.9}},{"label":"26.04-06","cq":"2Q26","rev":23047.0,"op":2604.0,"ni":1795.0,"opm":11.3,"yoy":{"rev":11.6,"op":16.1,"ni":6.5},"qoq":{"rev":-6.7,"op":-27.0,"ni":-27.2}},{"label":"26.07-09","cq":"3Q26","rev":22068.0,"op":2913.0,"ni":1856.0,"opm":13.2,"yoy":{"rev":5.9,"op":66.6,"ni":118.9},"qoq":{"rev":-4.2,"op":11.9,"ni":3.4}}],"note":{"headline":"양호 — 7~9월(3Q26) 영업이익 29억엔으로 67% 늘었다. 해외 볼펜과 엔화 약세로 매출총이익률이 4%포인트 가까이 올랐고 진척률이 5년 평균을 크게 넘었다. 다만 미국 관세 환급이 끼어 있고 매출은 추정에 못 미쳤다","about":"일본 필기구 회사. 볼펜 제트스트림·유니볼 젠토, 샤프, 사인펜, 연필 유니를 만들고, 2024년 독일 고급 만년필 브랜드 라미를 사들였다.\n매출의 60%가 해외다. 화장품 위탁 생산, 탄소 소재, 점착 테이프 같은 비필기구 사업도 한다. 2026년 4월 사모펀드 어드밴티지 파트너스와 손잡았다.","summary_md":"- **판정 양호.** 1~9월 경상이익이 연간 계획의 77.9%로 5년 평균 69.6%보다 8.3%포인트 높다. 기준상 서프라이즈지만 미국 관세 환급이라는 일회성 이익이 섞였고 계획을 올리지 않아 한 단계 낮췄다.\n- 7~9월 매출은 220.7억엔으로 5.9% 늘었다. 애널리스트 1명 추정 227.7억엔보다 3.1% 적다. 아시아 매출이 38.2% 늘었지만 미국은 11.5%, 화장품 등 비필기구는 17.9% 줄었다.\n- 영업이익은 29.1억엔으로 66.6% 늘었고 이익률은 8.4%에서 13.2%가 됐다. 매출총이익률이 48.8%에서 52.6%로 올랐다.\n- 1~9월 영업이익 증감 분석에 미국 추가 관세 환급 5억엔이 새로 들어갔다. 1~6월 분석에는 없던 항목이다.\n- 연간 계획을 맞추려면 10~12월 영업이익이 24.2억엔이면 된다. 1년 전보다 23% 적다. 회사는 해외 매출이 10~12월에 몰린다고 설명했다.\n- 발표는 장 마감 뒤였다. 종가 3,645엔, 야간 거래 3,690엔(+1.2%)."}}