.0,"timing":"after","time_known":true,"d1":2.7,"d1_d":"2026-10-13","d5":3.0,"d5_d":"2026-10-19"}},"qs":[{"label":"24.09-11","cq":"4Q24","rev":10926.0,"op":568.0,"ni":361.0,"opm":5.2,"yoy":{"rev":12.2,"op":null,"ni":null},"qoq":{"rev":3.1,"op":null,"ni":null}},{"label":"24.12-02","cq":"1Q25","rev":11632.0,"op":422.0,"ni":281.0,"opm":3.6,"yoy":{"rev":14.0,"op":null,"ni":null},"qoq":{"rev":6.5,"op":-25.7,"ni":-22.2}},{"label":"25.03-05","cq":"2Q25","rev":11114.0,"op":397.0,"ni":321.0,"opm":3.6,"yoy":{"rev":9.0,"op":null,"ni":null},"qoq":{"rev":-4.5,"op":-5.9,"ni":14.2}},{"label":"25.06-08","cq":"3Q25","rev":11285.0,"op":393.0,"ni":190.0,"opm":3.5,"yoy":{"rev":6.5,"op":null,"ni":null},"qoq":{"rev":1.5,"op":-1.0,"ni":-40.8}},{"label":"25.09-11","cq":"4Q25","rev":11084.0,"op":347.0,"ni":288.0,"opm":3.1,"yoy":{"rev":1.4,"op":-38.9,"ni":-20.2},"qoq":{"rev":-1.8,"op":-11.7,"ni":51.6}},{"label":"25.12-02","cq":"1Q26","rev":11601.0,"op":281.0,"ni":928.0,"opm":2.4,"yoy":{"rev":-0.3,"op":-33.4,"ni":230.2},"qoq":{"rev":4.7,"op":-19.0,"ni":222.2}},{"label":"26.03-05","cq":"2Q26","rev":11439.0,"op":599.0,"ni":342.0,"opm":5.2,"yoy":{"rev":2.9,"op":50.9,"ni":6.5},"qoq":{"rev":-1.4,"op":113.2,"ni":-63.1}},{"label":"26.06-08","cq":"3Q26","rev":11869.0,"op":519.0,"ni":325.0,"opm":4.4,"yoy":{"rev":5.2,"op":32.1,"ni":71.1},"qoq":{"rev":3.8,"op":-13.4,"ni":-5.0}}],"note":{"headline":"6~8월(3Q26) 매출 +5.2%·영업이익 +32% — 짬뽕 값 인상과 비용 관리로 이익률이 올랐지만, 연간 계획을 그대로 둬 남은 두 분기에 큰 폭의 증익이 필요","about":"나가사키 짬뽕 전문 체인 「링거헛」(559곳)과 돈가스 체인 「하마카쓰」(86곳)를 운영하는 일본 외식 기업이다. 국산 채소를 듬뿍 넣은 짬뽕·사라우동이 주력이다.\n매출의 8할이 짬뽕 사업에서 나오고, 점포의 절반 이상이 쇼핑센터 푸드코트에 있다. 냉동 짬뽕 같은 외부 판매와 태국·캄보디아 등 해외 16곳도 운영한다.","summary_md":"- **6~8월 영업이익이 32% 늘었다.** 3Q26(6~8월, 2027년 2월기 2분기) 매출은 118.7억엔으로 5.2% 늘었고, 영업이익은 5.2억엔이었다. 영업이익률은 4.4%로 전년(3.5%)보다 0.9%p 올랐다.\n- **짬뽕 사업이 이익을 거의 다 만들었다.** 링거헛 사업 영업이익이 4.1억엔으로 60% 늘었다. 돈가스 하마카쓰는 매출이 제자리였다.\n- **이익률 개선은 판관비 쪽에서 나왔다.** 매출원가율은 34.0%로 거의 그대로였고, 판관비율이 62.4%에서 61.6%로 내려갔다. 3~5월에 원가율이 1.1%p 내려간 것과 달리 가격 인상 효과는 줄어드는 흐름이다.\n- **순이익은 71% 늘어난 3.2억엔이다.** 다만 전년 6~8월 세금 부담이 유난히 컸던 영향이 크다. 실효세율이 50%에서 27%로 내려왔다.\n- **회사 계획은 넘었고 배당은 1엔 늘렸다.** 3~8월 두 분기 영업이익 11.2억엔은 회사 계획(9억엔)보다 24% 많다. 연간 계획(영업이익 22억엔)은 바꾸지 않았다. 남은 두 분기에 10.8억엔, 전년 같은 기간보다 72% 많은 이익이 필요하다.\n- **주가**: 장 마감 뒤 발표라 반응은 아직 없다. 발표일 종가는 2,314엔이다."}}