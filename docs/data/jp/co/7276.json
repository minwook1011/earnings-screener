26-10-27","base":2552.5,"timing":"intraday","time_known":true,"d1":-1.7,"d1_d":"2026-10-28","d5":null,"d5_d":null}},"qs":[{"label":"24.10-12","cq":"4Q24","rev":231098.0,"op":12065.0,"ni":17936.0,"opm":5.2,"yoy":{"rev":-6.4,"op":-24.6,"ni":60.1},"qoq":{"rev":7.8,"op":33.8,"ni":349.5}},{"label":"25.01-03","cq":"1Q25","rev":241538.0,"op":14741.0,"ni":17022.0,"opm":6.1,"yoy":{"rev":2.7,"op":97.9,"ni":308.2},"qoq":{"rev":4.5,"op":22.2,"ni":-5.1}},{"label":"25.04-06","cq":"2Q25","rev":219725.0,"op":11907.0,"ni":10120.0,"opm":5.4,"yoy":{"rev":-4.4,"op":31.6,"ni":38.6},"qoq":{"rev":-9.0,"op":-19.2,"ni":-40.5}},{"label":"25.07-09","cq":"3Q25","rev":227126.0,"op":7945.0,"ni":1721.0,"opm":3.5,"yoy":{"rev":6.0,"op":-11.9,"ni":-56.9},"qoq":{"rev":3.4,"op":-33.3,"ni":-83.0}},{"label":"25.10-12","cq":"4Q25","rev":243154.0,"op":13851.0,"ni":11215.0,"opm":5.7,"yoy":{"rev":5.2,"op":14.8,"ni":-37.5},"qoq":{"rev":7.1,"op":74.3,"ni":551.7}},{"label":"26.01-03","cq":"1Q26","rev":257605.0,"op":17735.0,"ni":-6517.0,"opm":6.9,"yoy":{"rev":6.7,"op":20.3,"ni":-138.3},"qoq":{"rev":5.9,"op":28.0,"ni":-158.1}},{"label":"26.04-06","cq":"2Q26","rev":240883.0,"op":16557.0,"ni":14657.0,"opm":6.9,"yoy":{"rev":9.6,"op":39.1,"ni":44.8},"qoq":{"rev":-6.5,"op":-6.6,"ni":null}},{"label":"26.07-09","cq":"3Q26","rev":237288.0,"op":14174.0,"ni":7725.0,"opm":6.0,"yoy":{"rev":4.5,"op":78.4,"ni":348.9},"qoq":{"rev":-1.5,"op":-14.4,"ni":-47.3}}],"note":{"headline":"부합 — 7~9월(3Q26) 영업이익 142억엔(+78%)·이익률 6.0%로 1년 전 부진에서 회복. 다만 직전 분기보다 14% 줄었고, 연간 계획은 올렸지만 남은 두 분기 몫은 오히려 낮췄다","about":"일본 최대 자동차 조명 회사. 도요타 계열로 헤드램프·후미등 같은 차량용 램프를 만들어 도요타·혼다·닛산 등 일본 완성차와 미국·중국·아시아 공장에 판다. 매출의 95% 가까이가 자동차 조명이다.\n일본·미주·아시아에서 돈을 벌고 중국·유럽은 구조조정 중이다. 철도 신호·교통 관제 장비와 자율주행용 라이다(레이저 거리 센서) 사업도 하지만 라이다는 적자다.","summary_md":"- **판정 부합.** 3Q26(7~9월, 2027년 3월기 2분기) 영업이익은 142억엔으로 1년 전 79억엔보다 78% 늘었다. 4~9월 경상이익 338억엔은 아이에프아이에스 컨센서스(346억엔)보다 2.4% 적었다.\n- 매출은 2,373억엔(+4.5%)으로 야후 컨센서스(2,368억엔)와 거의 같았다. 회사는 달러 강세와 일본·미주·아시아 신규 수주를 이유로 들었다.\n- 이익 회복은 라이다 적자 축소와 미주 흑자 전환에서 나왔다. 라이다 사업 손실은 29억엔에서 4억엔으로 줄었고, 미주 지역은 15억엔 손실에서 20억엔 이익으로 돌아섰다.\n- 직전 분기(4~6월)보다는 영업이익이 14% 줄었다. 미주·아시아 이익이 줄고 중국 적자가 커졌으며, 회사가 밝힌 원재료값 영향이 이어졌다.\n- 연간 계획은 영업이익 600억엔→610억엔, 순이익 395억엔→430억엔으로 올렸다. 그래도 남은 두 분기 영업이익은 303억엔으로 1년 전보다 4% 적고, 7월 계획보다 47억엔 낮다. 전자부품 값 급등을 이유로 들었다.\n- 연 배당은 58엔에서 64엔으로 올렸다. 발표는 장 마감 30분 전(15시)이었고 당일 종가는 2,508.5엔(−1.7%)이었다."}}