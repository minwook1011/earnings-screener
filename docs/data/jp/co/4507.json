ase_d":"2026-10-28","base":2991.0,"timing":"intraday","time_known":true,"d1":null,"d1_d":null,"d5":null,"d5_d":null}},"qs":[{"label":"24.10-12","cq":"4Q24","rev":119630.0,"op":53355.0,"ni":50670.0,"opm":44.6,"yoy":{"rev":-8.9,"op":31.4,"ni":null},"qoq":{"rev":2.8,"op":11.6,"ni":null}},{"label":"25.01-03","cq":"1Q25","rev":104668.0,"op":27379.0,"ni":36632.0,"opm":26.2,"yoy":{"rev":42.8,"op":87.5,"ni":null},"qoq":{"rev":-12.5,"op":-48.7,"ni":-27.7}},{"label":"25.04-06","cq":"2Q25","rev":99781.0,"op":35097.0,"ni":39355.0,"opm":35.2,"yoy":{"rev":2.2,"op":24.9,"ni":null},"qoq":{"rev":-4.7,"op":28.2,"ni":7.4}},{"label":"25.07-09","cq":"3Q25","rev":113184.0,"op":38880.0,"ni":43644.0,"opm":34.4,"yoy":{"rev":-2.8,"op":-18.7,"ni":null},"qoq":{"rev":13.4,"op":10.8,"ni":10.9}},{"label":"25.10-12","cq":"4Q25","rev":147719.0,"op":74762.0,"ni":75226.0,"opm":50.6,"yoy":{"rev":23.5,"op":40.1,"ni":48.5},"qoq":{"rev":30.5,"op":92.3,"ni":72.4}},{"label":"26.01-03","cq":"1Q26","rev":138993.0,"op":17986.0,"ni":46934.0,"opm":12.9,"yoy":{"rev":32.8,"op":-34.3,"ni":28.1},"qoq":{"rev":-5.9,"op":-75.9,"ni":-37.6}},{"label":"26.04-06","cq":"2Q26","rev":163310.0,"op":66911.0,"ni":97696.0,"opm":41.0,"yoy":{"rev":63.7,"op":90.6,"ni":148.2},"qoq":{"rev":17.5,"op":272.0,"ni":108.2}},{"label":"26.07-09","cq":"3Q26","rev":187067.0,"op":48333.0,"ni":21850.0,"opm":25.8,"yoy":{"rev":65.3,"op":24.3,"ni":-49.9},"qoq":{"rev":14.5,"op":-27.8,"ni":-77.6}}],"note":{"headline":"진척률 기준 양호 — 7~9월(3Q26) 매출 1,871억엔(+65%)·영업이익 640억엔(+65%). 사들인 라디카바와 에이즈약 로열티가 성장을 이끌었고 연간 계획도 올렸지만, 환차손과 중국 사업 매각 손실로 순이익은 13.5% 줄었다","about":"오사카에 본사를 둔 일본 대형 제약사다. 독감약 조플루자·코로나약 조코바 같은 감염병 약과 녹농균 등 내성균 항생제 세피데로콜(미국명 Fetroja)이 간판이다.\n가장 큰 돈줄은 영국 GSK와 함께 세운 에이즈약 회사 비브(ViiV)에서 받는 로열티와 지분 이익이다. 2025~2026년 도리이약품·JT 의약사업·다나베파마의 루게릭병약 라디카바를 잇달아 사들여 희귀질환과 국내 만성질환 약으로 넓히고 있다.","summary_md":"- **판정 양호(회사 계획 진척률 기준)**: 4~9월 세전이익이 연간 계획의 48.6%로 과거 2년 평균(43.5%)보다 5.1%p 앞섰고 연간 계획도 올렸다. 다만 10~3월 영업이익 계획은 5월보다 92억엔 낮아져 한 단계 낮췄다.\n- **3Q26(7~9월, 2027년 3월기 2분기) 3개월 실적**(회사 소급 수정 기준): 매출 **1,871억엔(+65.3%)**, 영업이익 **640억엔(+64.6%)**, 영업이익률 34.2%(전년 34.4%), 순이익 377억엔(−13.5%).\n- **숫자 주의**: 회사가 4~6월 숫자를 인수 회계 확정으로 고쳤다. 고치기 전 4~6월을 빼면 7~9월 영업이익이 483억엔으로 보인다. 사이트 분기표와 카부탄 속보의 숫자가 이것이다.\n- **성장 동력**: 라디카바 267억엔, 로열티 853억엔(+30%), 도리이약품 관련 제품 206억엔. 미국 자회사 매출은 420억엔으로 1년 전의 5.7배다. 반면 감염병 약은 45억엔으로 22% 줄었다.\n- **시장 예상 대비**: 7~9월 매출은 애널리스트 6명 평균(1,757억엔)보다 6.5% 많았다. 주당순이익 44.3엔은 5명 평균(43.6엔)과 비슷했다.\n- **계획·배당**: 연간 매출 7,000→7,200억엔, 영업이익 2,200→2,300억엔, 순이익 2,100→2,125억엔. 배당은 76→86엔. 주가는 13시 53분 기준 +0.7%."}}