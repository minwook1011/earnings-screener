0-28","base":2012.0,"timing":"after","time_known":true,"d1":7.0,"d1_d":"2026-10-29","d5":null,"d5_d":null}},"qs":[{"label":"24.10-12","cq":"4Q24","rev":217928.0,"op":13460.0,"ni":10175.0,"opm":6.2,"yoy":{"rev":-2.6,"op":-17.9,"ni":-8.3},"qoq":{"rev":1.1,"op":5.2,"ni":6.9}},{"label":"25.01-03","cq":"1Q25","rev":204045.0,"op":6910.0,"ni":4146.0,"opm":3.4,"yoy":{"rev":-1.7,"op":17.1,"ni":85.9},"qoq":{"rev":-6.4,"op":-48.7,"ni":-59.3}},{"label":"25.04-06","cq":"2Q25","rev":215364.0,"op":11296.0,"ni":11620.0,"opm":5.2,"yoy":{"rev":0.7,"op":-14.4,"ni":7.6},"qoq":{"rev":5.5,"op":63.5,"ni":180.3}},{"label":"25.07-09","cq":"3Q25","rev":215946.0,"op":11337.0,"ni":-1295.0,"opm":5.2,"yoy":{"rev":0.2,"op":-11.4,"ni":-113.6},"qoq":{"rev":0.3,"op":0.4,"ni":-111.1}},{"label":"25.10-12","cq":"4Q25","rev":222645.0,"op":14865.0,"ni":12596.0,"opm":6.7,"yoy":{"rev":2.2,"op":10.4,"ni":23.8},"qoq":{"rev":3.1,"op":31.1,"ni":null}},{"label":"26.01-03","cq":"1Q26","rev":211049.0,"op":9187.0,"ni":9668.0,"opm":4.4,"yoy":{"rev":3.4,"op":33.0,"ni":133.2},"qoq":{"rev":-5.2,"op":-38.2,"ni":-23.2}},{"label":"26.04-06","cq":"2Q26","rev":217681.0,"op":11197.0,"ni":9349.0,"opm":5.1,"yoy":{"rev":1.1,"op":-0.9,"ni":-19.5},"qoq":{"rev":3.1,"op":21.9,"ni":-3.3}},{"label":"26.07-09","cq":"3Q26","rev":224075.0,"op":11626.0,"ni":8805.0,"opm":5.2,"yoy":{"rev":3.8,"op":2.5,"ni":null},"qoq":{"rev":2.9,"op":3.8,"ni":-5.8}}],"note":{"headline":"7~9월(3Q26) 영업이익 +2.5%, 회사 계획 상회(양호) — 미국 제분·해외 프리믹스와 효모가 이끌고, 날씨와 비용에 눌린 편의점 반찬 사업은 이익 −30%. 연간 이익 계획은 그대로, 200억엔 자사주 매입","about":"일본 최대 제분 회사 닛신 세이훈을 거느린 지주회사. 빵·면·과자용 업무용 밀가루, 마·마 파스타 같은 가정용 식품, 빵 효모, 편의점 도시락·반찬을 만들고, 미국·캐나다·호주·뉴질랜드·태국에서도 밀가루를 판다.\n밀가루 값은 정부가 1년에 두 번 정하는 수입 밀 매도가에 맞춰 움직이고, 이익의 약 40%가 해외에서 나와 환율 영향이 크다.","summary_md":"- **회사 계획 상회(양호)** — 3Q26(7~9월, 2027년 3월기 2분기) 3개월 매출 **2,241억엔(+3.8%)**, 영업이익 **116억엔(+2.5%)**. 회사가 5월에 낸 4~9월 계획에서 역산한 7~9월 몫(108억엔)보다 **+7.6%** 많았다.\n- **좋았던 곳**: 제분 영업이익 68억엔(+5.9%). 미국 생산 확대와 엔화 약세로 해외 제분 매출이 약 17% 늘었다. 식품은 해외 프리믹스와 빵 효모 덕에 이익이 +20.8%.\n- **나빴던 곳**: 편의점용 도시락·반찬 사업 매출 −4.0%, 영업이익 **−29.5%**. 회사는 날씨 탓 판매 부진과 비용 상승을 들었다. 국내 제분도 중동 정세로 비용이 올라 이익이 줄었다.\n- 영업이익률 5.2%로 전년과 같다. 매출총이익률은 0.5%p 올랐지만 판관비율도 0.6%p 올랐다. 시장 예상 매출(애널리스트 3명 평균 2,225억엔)보다는 0.7% 많았다.\n- **연간 계획**: 매출만 8,700억엔→9,000억엔으로 올리고 이익(영업 460억엔)은 유지. 경상이익 진척률 49.1%로 5년 평균보다 3.3%p 낮다. 남은 두 분기 영업이익 232억엔(전년 같은 기간 대비 −3.6%)이면 된다.\n- **주주환원**: 연 배당 65엔(5엔 증액) 유지에 더해 200억엔 자사주 매입. 발표는 장 마감 뒤라 주가 반응은 10/29부터다."}}