25.0,"ni":26006.0,"opm":7.0,"yoy":null,"qoq":{"rev":5.5,"op":-2.5,"ni":19.4}},{"label":"25.04-06","cq":"2Q25","rev":325534.0,"op":39776.0,"ni":-201348.0,"opm":12.2,"yoy":null,"qoq":{"rev":5.4,"op":84.8,"ni":-874.2}},{"label":"25.07-09","cq":"3Q25","rev":335364.0,"op":72620.0,"ni":106256.0,"opm":21.7,"yoy":null,"qoq":{"rev":3.0,"op":82.6,"ni":null}},{"label":"25.10-12","cq":"4Q25","rev":351537.0,"op":67245.0,"ni":17323.0,"opm":19.1,"yoy":{"rev":20.1,"op":204.5,"ni":-20.5},"qoq":{"rev":4.8,"op":-7.4,"ni":-83.7}},{"label":"26.01-03","cq":"1Q26","rev":380293.0,"op":90564.0,"ni":68149.0,"opm":23.8,"yoy":{"rev":23.2,"op":320.7,"ni":162.1},"qoq":{"rev":8.2,"op":34.7,"ni":293.4}},{"label":"26.04-06","cq":"2Q26","rev":418449.0,"op":102116.0,"ni":149184.0,"opm":24.4,"yoy":{"rev":28.5,"op":156.7,"ni":null},"qoq":{"rev":10.0,"op":12.8,"ni":118.9}},{"label":"26.07-09","cq":"3Q26","rev":435917.0,"op":565311.0,"ni":372193.0,"opm":129.7,"yoy":{"rev":30.0,"op":678.5,"ni":250.3},"qoq":{"rev":4.2,"op":453.6,"ni":149.5}}],"note":{"headline":"7~9월(3Q26) 시장 예상 부합 — 데이터센터 덕에 매출 +30%·이익률 34.6%로 회사 전망을 넘었지만, 10~12월 이익률은 32.0%로 내려간다는 전망에 주가 −8%","about":"자동차·산업 기기에 들어가는 마이크로컨트롤러(기기를 제어하는 소형 칩)를 세계에서 가장 많이 파는 회사 가운데 하나다. 아날로그·전원 칩과 자동차용 시스템 반도체(SoC), 설계 소프트웨어(알티움)까지 묶어 판다.\n매출은 자동차용과 산업·인프라·사물인터넷용이 반반이고, 최근에는 데이터센터용 전원 칩·메모리 인터페이스 칩이 성장을 이끈다. 매출의 약 80%가 일본 밖에서 나온다.","summary_md":"- **판정 부합**: 3Q26(7~9월, 2026년 12월기 3분기) 회사 기준(일회성 제외) 주당이익 약 68.3엔은 야후 컨센서스 68.2엔과 같았다. 매출 4,359억엔(회계 기준)도 컨센서스 4,355억엔과 같다.\n- **회사 기준 실적**: 매출 **4,352억엔(+30.2% 전년 대비)**, 영업이익 **1,505억엔(+45.8%)**, 영업이익률 **34.6%**(전년 30.9%). 7월에 낸 회사 전망(매출 4,300억엔·이익률 32.5%)보다 영업이익이 약 7.7% 많다.\n- **동력은 산업·인프라·사물인터넷**: 이 사업 매출이 2,438억엔(+46.4%), 직전 분기보다 12.7% 늘었다. 데이터센터가 전체 매출의 21%까지 올라왔다. 자동차는 1,895억엔(+19.3%)이지만 직전 분기 대비 +1.3%에 그쳤다.\n- **회계 기준 영업이익 5,653억엔**은 타이밍 사업 매각익 4,503억엔이 들어간 숫자다. 울프스피드 관련 금융자산 평가손 449억엔은 금융비용에 잡혔다.\n- **10~12월 전망**: 매출 4,540억엔(직전 분기 대비 +4.3%)으로 컨센서스 4,430억엔보다 2.5% 높다. 반면 매출총이익률 58.0%(−1.4%포인트), 영업이익률 32.0%(−2.6%포인트)로 영업이익은 약 1,453억엔, 직전 분기보다 줄어든다.\n- **주가**: 오전 9시 발표 뒤 오전장 종가 2,851엔, 전날 대비 −8.0%. 10월 6일 고점(3,995엔)보다 약 29% 낮다."}}