":"4Q24","rev":134223.0,"op":21966.0,"ni":19157.0,"opm":16.4,"yoy":{"rev":2.3,"op":-53.9,"ni":null},"qoq":{"rev":9.4,"op":21.4,"ni":null}},{"label":"25.01-03","cq":"1Q25","rev":112309.0,"op":-11007.0,"ni":-6545.0,"opm":-9.8,"yoy":{"rev":-0.4,"op":-171.9,"ni":null},"qoq":{"rev":-16.3,"op":-150.1,"ni":-134.2}},{"label":"25.04-06","cq":"2Q25","rev":127536.0,"op":21995.0,"ni":17673.0,"opm":17.2,"yoy":{"rev":8.4,"op":-28.4,"ni":null},"qoq":{"rev":13.6,"op":null,"ni":null}},{"label":"25.07-09","cq":"3Q25","rev":129600.0,"op":30074.0,"ni":22416.0,"opm":23.2,"yoy":{"rev":5.6,"op":66.2,"ni":null},"qoq":{"rev":1.6,"op":36.7,"ni":26.8}},{"label":"25.10-12","cq":"4Q25","rev":139900.0,"op":36223.0,"ni":28860.0,"opm":25.9,"yoy":{"rev":4.2,"op":64.9,"ni":50.6},"qoq":{"rev":7.9,"op":20.4,"ni":28.7}},{"label":"26.01-03","cq":"1Q26","rev":118749.0,"op":3944.0,"ni":818.0,"opm":3.3,"yoy":{"rev":5.7,"op":null,"ni":null},"qoq":{"rev":-15.1,"op":-89.1,"ni":-97.2}},{"label":"26.04-06","cq":"2Q26","rev":116160.0,"op":30653.0,"ni":24151.0,"opm":26.4,"yoy":{"rev":-8.9,"op":39.4,"ni":36.7},"qoq":{"rev":-2.2,"op":677.2,"ni":2852.4}},{"label":"26.07-09","cq":"3Q26","rev":116344.0,"op":27254.0,"ni":20779.0,"opm":23.4,"yoy":{"rev":-10.2,"op":-9.4,"ni":-7.3},"qoq":{"rev":0.2,"op":-11.1,"ni":-14.0}}],"note":{"headline":"컨센서스 하회(부진) — 로열티·미국 신약은 늘었지만 연구비가 불어 7~9월 영업이익 9% 감소, 같은 날 나온 통증 신약 2상도 실망","about":"면역항암제 옵디보를 처음 만든 일본 오사카의 신약 회사다. 일본에서는 옵디보 등 처방약을 직접 팔고, 미국 자회사 데시페라를 통해 위장관기질종양 약 킨록과 건활막거대세포종 약 롬빔자를 판다.\n브리스톨마이어스스퀴브(옵디보)와 머크(키트루다)에서 받는 로열티가 매출의 40% 안팎이다. 이익의 큰 몫이 이 로열티에서 나온다.","summary_md":"- **컨센서스 하회(부진).** 7~9월 주당순이익 44.2엔으로 야후 컨센서스 47.3엔(3명)을 6.6% 밑돌았다. 매출 1,163억엔은 예상(1,166억엔)과 거의 같았다.\n- 매출은 1,163억엔으로 10.2% 줄었다. 아스트라제네카와의 포시가 공동판매가 끝나 전년 7~9월 237억엔이 통째로 빠졌다.\n- 로열티 등은 482억엔(+13%), 해외 제품은 196억엔(+31%)으로 늘었다. 다만 4~9월 증가분의 상당 부분이 엔저 효과다.\n- 영업이익은 272억엔(−9.4%)이다. 일회성 제외 영업이익은 349억엔(−9%)으로, 연구개발비가 4~6월보다 13% 늘어난 영향이 컸다.\n- 연간 계획(영업이익 940억엔)은 유지했다. 남은 두 분기는 분기당 약 180억엔이면 돼 보수적인 편이다.\n- 주가는 발표 뒤 장중 약 12% 급락했다. 이익 감소에 통증 신약 ONO-1110의 애매한 2상 결과가 겹쳤다."}}