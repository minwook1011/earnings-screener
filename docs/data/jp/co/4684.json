":"2026-10-27","base":5940.0,"timing":"after","time_known":true,"d1":null,"d1_d":null,"d5":null,"d5_d":null}},"qs":[{"label":"24.10-12","cq":"4Q24","rev":30550.0,"op":19937.0,"ni":16961.0,"opm":65.3,"yoy":{"rev":8.0,"op":10.1,"ni":11.6},"qoq":{"rev":0.5,"op":-0.3,"ni":10.9}},{"label":"25.01-03","cq":"1Q25","rev":31517.0,"op":19812.0,"ni":15601.0,"opm":62.9,"yoy":{"rev":12.6,"op":13.9,"ni":7.6},"qoq":{"rev":3.2,"op":-0.6,"ni":-8.0}},{"label":"25.04-06","cq":"2Q25","rev":32431.0,"op":21479.0,"ni":19512.0,"opm":66.2,"yoy":{"rev":12.6,"op":15.5,"ni":16.1},"qoq":{"rev":2.9,"op":8.4,"ni":25.1}},{"label":"25.07-09","cq":"3Q25","rev":33353.0,"op":22176.0,"ni":17791.0,"opm":66.5,"yoy":{"rev":9.7,"op":10.9,"ni":16.3},"qoq":{"rev":2.8,"op":3.2,"ni":-8.8}},{"label":"25.10-12","cq":"4Q25","rev":34329.0,"op":22610.0,"ni":19313.0,"opm":65.9,"yoy":{"rev":12.4,"op":13.4,"ni":13.9},"qoq":{"rev":2.9,"op":2.0,"ni":8.6}},{"label":"26.01-03","cq":"1Q26","rev":35096.0,"op":22558.0,"ni":18575.0,"opm":64.3,"yoy":{"rev":11.4,"op":13.9,"ni":19.1},"qoq":{"rev":2.2,"op":-0.2,"ni":-3.8}},{"label":"26.04-06","cq":"2Q26","rev":36698.0,"op":24860.0,"ni":22697.0,"opm":67.7,"yoy":{"rev":13.2,"op":15.7,"ni":16.3},"qoq":{"rev":4.6,"op":10.2,"ni":22.2}},{"label":"26.07-09","cq":"3Q26","rev":38325.0,"op":26178.0,"ni":21686.0,"opm":68.3,"yoy":{"rev":14.9,"op":18.0,"ni":21.9},"qoq":{"rev":4.4,"op":5.3,"ni":-4.5}}],"note":{"headline":"양호 — 7~9월(3Q26) 매출 +14.9%·영업이익 +18.0%로 세 분기째 성장 가속, 분기 주당순이익은 시장 예상을 6% 넘었고 연간 계획과 배당도 올렸다","about":"일본 중견·대기업에 회계 중심 통합업무 소프트웨어 '오비크7 시리즈'를 직접 개발해 직접 파는 회사다. 시스템 구축(매출의 약 41%)과 구축 뒤 운용 지원·유지보수·클라우드(약 53%)가 두 축이고, 나머지는 사무기기 판매다.\n한 번 구축한 고객이 해마다 유지보수·클라우드 이용료를 내서 영업이익률이 66% 안팎으로 매우 높고, 영업이익은 32년 연속 늘었다(2026년 4월 설명자료). 중소기업용 회계 소프트웨어 '부교'를 파는 오비크 비즈니스 컨설턴트의 최대주주이기도 하다.","summary_md":"- **시장 예상 상회(양호)**: 3Q26(2026년 7~9월, 2027년 3월기 2분기) 매출은 **383.3억엔(전년 대비 +14.9%)**, 영업이익은 **261.8억엔(+18.0%)**이다. 분기 주당순이익 약 50.0엔은 야후 집계 시장 예상 47.1엔보다 6.2% 많다.\n- **성장 가속**: 영업이익 증가율이 1~3월 13.9%, 4~6월 15.7%에 이어 18.0%로 세 분기 연속 커졌다. 대기업 신규 고객 구축(+12.5%)과 클라우드 중심 유지보수(+16.9%)가 함께 늘었다.\n- **이익률**: 영업이익률은 **68.3%**로 전년 같은 분기보다 1.8%p 올랐다. 매출원가는 10.2%, 판관비는 6.1% 늘어 매출보다 느렸다.\n- **경상이익 307.8억엔(+23.2%)**: 투자주식 매각이익 21.2억엔(전년 10.2억엔)과 지분법 이익 19.7억엔이 보탰다. 매각이익을 빼면 경상이익 증가율은 19.6%다.\n- **연간 계획 상향**: 영업이익 980억엔 → **1,005억엔**, 경상이익 1,145억엔 → 1,200억엔, 배당 94엔 → 100엔. 남은 두 분기에 영업이익 494.6억엔(전년 같은 기간 대비 +9.5%)이면 된다.\n- **주가**: 발표는 장 마감 뒤였다. 27일 종가는 5,940엔(−1.8%)이고, 10월 들어 발표 전까지 약 22% 올라 있었다."}}