9.3,"post6":7.9,"post12":-9.0},{"m":"2022-12","v":-18.9,"post6":48.1,"post12":30.0},{"m":"2024-08","v":-15.2,"post6":-13.3,"post12":-28.7},{"m":"2025-08","v":-10.5,"post6":2.2,"post12":5.3}],"phase":{"q":"2026-09","peer_yoy":11.5,"dir":"횡보","since_trough":6,"last_trough":"2025-03","ret_since":-35.8,"gap":18.1,"gap_m":"2026-03","gap_dir":"개선"},"text":["이 회사는 「업황 사이클형」 — 파워모듈·다이오드(인버터용)와 AI 서버 기판 도금 전원 — 산업 설비·기판 투자","밸류체인 4곳 합산 매출은 2026-09 분기 전년비 +11.5%, 반년 전보다 횡보 중입니다. 마지막 업계 바닥은 2025-03 분기(바닥 뒤 6분기째).","고객 산업(전기기계) 출하−재고 갭은 2026-03 +18.1%p로 석 달 전보다 개선 — 갭이 바닥에서 올라오면 재고 조정이 끝나 가는 신호입니다.","과거 업계 매출 성장률 바닥 5번에서, 이 회사 주가는 바닥 뒤 1년 동안 TOPIX 대비 평균 -8%p(바닥 전 반년은 평균 +2%p — 주가가 먼저 움직인 정도).","주가와 업계 매출 성장률 변화의 관계는 뚜렷하지 않습니다 — 이 회사 주가는 업황보다 회사 고유 요인(신제품·점유율·밸류에이션)에 더 움직였습니다.","업계 매출 성장률이 10%p 바뀔 때 이 회사 매출 성장률은 평균 +10%p 바뀌었습니다(상관 +0.41) — 업계와 비슷하게 움직임.","고객 산업 재고 갭 바닥 6번 뒤 1년 초과수익은 평균 -8%p."]}