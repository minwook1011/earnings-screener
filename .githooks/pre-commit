#!/bin/sh
# 공개 저장소 보호 — 비밀·개인 정보가 섞인 커밋을 막는다(OPERATIONS.md '보안').
fail=0
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

for f in $files; do
  case "$f" in
    tools/tg_raw/*|tools/req.json|tools/req_raw.json|*.session|*.session-journal|telegram_bot.json|*config.json|.env|*.env|*.pem|*.key)
      echo "막음: 올리면 안 되는 파일 — $f"; fail=1 ;;
  esac
done

# 토큰 모양(텔레 봇 토큰·깃허브·클로드·구글 키), 텔레 API 설정, 개인 경로·이메일·텔레 그룹 번호
pat='[0-9]{8,10}:[A-Za-z0-9_-]{35}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|api_hash|api_id"?[[:space:]]*[:=]|[Cc]:[\\/]+Users[\\/]|OneDrive|@gmail\.com|-100[0-9]{10}|\.ts\.net'
hits=$(git diff --cached -U0 --diff-filter=ACMR -- . ':!.githooks/*' | grep '^+' | grep -v '^+++' | grep -E -n "$pat")
if [ -n "$hits" ]; then
  echo "막음: 비밀·개인 정보로 보이는 줄"; echo "$hits" | cut -c1-160; fail=1
fi

[ $fail -ne 0 ] && { echo "커밋을 멈췄습니다. 위 내용을 빼고 다시 커밋하세요."; exit 1; }
exit 0
